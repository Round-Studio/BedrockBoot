<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.DownloadSubPage.CurseForge.CurseForgePackBuildFile">
    <Grid>
        <ScrollViewer>
            <StackPanel Margin="15"
                        Name="List"></StackPanel>
        </ScrollViewer>
        
        <notice:LoadCard Grid.Row="1" HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         BigTitle="收集电子中..."
                         Message="全体电子，列队！"
                         Name="LoadingRing"></notice:LoadCard>
    </Grid>
</UserControl>
