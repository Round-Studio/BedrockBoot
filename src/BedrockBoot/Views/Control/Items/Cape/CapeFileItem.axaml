<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Control.Items.Cape.CapeFileItem">
    <onePointControls:SettingExpander Name="SettingExpander"
                                      Header="Cape"
                                      Glyph="&#xF012;"
                                      IsFontIcon="False">
        <StackPanel>
            <StackPanel Name="ControlPanel">
                <onePointControls:SettingCard Name="Delete"
                                              IsClickable="True"
                                              Glyph="&#xE74D;"
                                              Click="DeleteBtn_OnClick"
                                              Header="删除该披风">
                </onePointControls:SettingCard>
            </StackPanel>
        </StackPanel>
    </onePointControls:SettingExpander>
</UserControl>
