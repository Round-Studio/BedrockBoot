<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="BedrockBoot.Views.DialogContent.DialogAddGameFolderContent">
    <StackPanel>
        <TextBlock Margin="0,5,0,5"
                   HorizontalAlignment="Left"
                   Text="{DynamicResource Dialog.AddGameFolder.Label.Name}" />
        
        <TextBox Margin="0,5,0,5" MinWidth="320"
                 HorizontalAlignment="Stretch"
                 Name="PathNameInputBox" />
        
        <TextBlock Margin="0,5,0,5"
                   HorizontalAlignment="Left"
                   Text="{DynamicResource Dialog.AddGameFolder.Label.Path}" />
        
        <DockPanel>
            <Button DockPanel.Dock="Right"
                    Margin="5,5,0,5"
                    Padding="12,0"
                    Classes="NoBorder"
                    Name="OpenChooseFolderBtn"
                    Click="OpenChooseFolderBtn_OnClick"
                    Content="{DynamicResource Shared.Action.Browse}" />

            <TextBox Margin="0,5,5,5"
                     Name="PathInputBox" />
        </DockPanel>
    </StackPanel>
</UserControl>