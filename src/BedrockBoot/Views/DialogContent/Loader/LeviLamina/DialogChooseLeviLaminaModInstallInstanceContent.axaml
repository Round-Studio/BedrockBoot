<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d"
             x:Class="BedrockBoot.Views.DialogContent.Loader.LeviLamina.DialogChooseLeviLaminaModInstallInstanceContent">
    <Grid Width="420"
          ClipToBounds="True"
          RowSpacing="8"
          RowDefinitions="Auto,Auto">
        <TabControl Grid.Row="0"
                    Name="DownloadType"
                    Margin="0,-6,0,0">
            <TabItem Header="{DynamicResource Dialog.LeviLamina.ModInstall.ToInstance}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Dialog.LeviLamina.ModInstall.ToInstance.Desc}"
                               TextWrapping="WrapWithOverflow"
                               Opacity="0.6">
                    </TextBlock>

                    <ComboBox Name="ComboBox"
                              HorizontalAlignment="Stretch">
                    </ComboBox>

                    <TextBlock Foreground="Red"
                               Name="NotFound"
                               IsVisible="False"
                               Text="{DynamicResource Dialog.LeviLamina.ModInstall.NoInstance}">
                    </TextBlock>

                    <TextBlock Text="{DynamicResource Dialog.LeviLamina.ModInstall.ChooseInstance}"
                               TextWrapping="WrapWithOverflow"
                               Opacity="0.6">
                    </TextBlock>
                </StackPanel>
            </TabItem>
            <TabItem Header="{DynamicResource Dialog.LeviLamina.ModInstall.DownloadLocal}"
                     IsEnabled="False">
                <items:BorderCard Height="120">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                        <onePointControls:FontIcon HorizontalAlignment="Center"
                                                   FontSize="18"
                                                   Glyph="&#xE74E;" />
                        <Button Content="{DynamicResource Dialog.LeviLamina.ModInstall.ChooseSaveLocation}"
                                Name="SelectFolder"
                                Click="SelectFolder_OnClick"
                                Padding="12,8">
                        </Button>
                    </StackPanel>
                </items:BorderCard>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Name="DepsList">
            <TextBlock Text="{DynamicResource Dialog.LeviLamina.ModInstall.Dependencies}"
                       Name="ModDeps"
                       TextWrapping="WrapWithOverflow"
                       Opacity="0.6">
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>