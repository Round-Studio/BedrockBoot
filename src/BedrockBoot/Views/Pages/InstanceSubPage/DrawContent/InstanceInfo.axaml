<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             xmlns:widgets="clr-namespace:BedrockBoot.Views.Control.Widgets"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.InstanceSubPage.DrawContent.InstanceInfo">
    <Grid>
        <ScrollViewer>
            <StackPanel Margin="20,0,20,15"
                        Spacing="8">
                <items:BorderCard Padding="0"
                                  ClipToBounds="True">
                    <Grid Height="240">
                        <widgets:LocalImageRenderWidget Name="IconBox" />

                        <Border CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#E7000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Spacing="8"
                                    Margin="8">
                            <Button Classes="NoBorder"
                                    Name="ResetImageBtn"
                                    Click="ResetImageBtn_OnClick"
                                    Padding="8">
                                <onePointControls:FontIcon Glyph="&#xE777;" />
                            </Button>
                            <Button Classes="NoBorder"
                                    Name="ChooseNewImageBtn"
                                    Click="ChooseNewImageBtn_OnClick"
                                    Padding="8">
                                <onePointControls:FontIcon Glyph="&#xE8AB;" />
                            </Button>
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto, *, Auto" Margin="30">
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                                <TextBlock FontSize="32"
                                           FontWeight="Black"
                                           Foreground="White"
                                           Name="VersionName"
                                           Text="VERSION NAME"
                                           LetterSpacing="1" />

                                <StackPanel Orientation="Horizontal" Spacing="15" Opacity="0.8">
                                    <TextBlock FontSize="13"
                                               Foreground="#66C0F4"
                                               FontWeight="SemiBold"
                                               Name="VersionReady"
                                               Text="READY TO LAUNCH" />

                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <onePointControls:FontIcon FontSize="14" Glyph="&#xE916;" Foreground="White" />
                                        <TextBlock FontSize="13" Foreground="White" Name="TotalDuration"
                                                   Text="120 HOURS" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Bottom"
                                        Orientation="Horizontal"
                                        Spacing="10">

                                <Button Name="LaunchBtn"
                                        Click="LaunchBtn_OnClick"
                                        Width="160"
                                        Height="50"
                                        CornerRadius="4"
                                        BorderThickness="0"
                                        Classes="Accent">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <onePointControls:FontIcon Glyph="&#xE768;"
                                                                   FontSize="18"
                                                                   Foreground="White"
                                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Shared.Action.Launch}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="White" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </items:BorderCard>

                <TextBlock FontWeight="Bold"
                           FontSize="14"
                           Text="{DynamicResource Settings.Game.Group.Base}" />

                <onePointControls:SettingCard Glyph="&#xE8AC;"
                                              Header="{DynamicResource Instance.Info.Name.Title}"
                                              Description="{DynamicResource Instance.Info.Name.Desc}">
                    <TextBox Width="200"
                             Name="InstanceName"
                             TextChanged="TextTypeConfig_OnChanged" />
                </onePointControls:SettingCard>

                <onePointControls:SettingCard Glyph="&#xEB9F;"
                                              Name="GameIconCard"
                                              Header="{DynamicResource Instance.Info.Icon.Title}"
                                              Description="{DynamicResource Instance.Info.Icon.Desc}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Border CornerRadius="6"
                                Height="74"
                                Width="74"
                                ClipToBounds="True">
                            <Image Source="avares://BedrockBoot/Assets/Icon/Logo/Grass.png" 
                                   Name="GameIcon"/>
                        </Border>
                        
                        <StackPanel Spacing="8"
                                    MaxWidth="200"
                                    Width="200">
                            <ComboBox Name="GameIconSel"
                                      Width="200"
                                      SelectionChanged="GameIconSel_OnSelectionChanged"
                                      SelectedIndex="1">
                                <ComboBoxItem Content="自定义" />
                                <ComboBoxItem Content="默认" />
                                <ComboBoxItem Content="草方块" />
                                <ComboBoxItem Content="草经" />
                                <ComboBoxItem Content="工作台" />
                                <ComboBoxItem Content="圆石" />
                                <ComboBoxItem Content="末地石" />
                            </ComboBox>
                        
                            <DockPanel HorizontalSpacing="8"
                                       Name="CustomizationBox">
                                <Button DockPanel.Dock="Right"
                                        Content="选择"
                                        Padding="8"
                                        Name="IconPathChooseBtn"
                                        Click="IconPathChooseBtn_OnClick"></Button>
                                <TextBox Name="IconPathInput"></TextBox>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </onePointControls:SettingCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>