<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400"
             x:Class="BedrockBoot.Views.Control.Items.GameModItem">
    <onePointControls:SettingExpander Name="Card"
                                      Margin="5,0,5,10"
                                      Glyph="&#xE7C3;"
                                      Description="FileSize">
        <onePointControls:SettingExpander.Header>
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <TextBlock Name="FileName" 
                           Text="FineName"/>
                <onePointControls:LabelBox Text="Version"
                                           IsVisible="False"
                                           Foreground="White"
                                           Name="VersionBox"
                                           VerticalAlignment="Center" />
                <onePointControls:LabelBox Text="{DynamicResource Instance.Mods.Label.Preload}"
                                           Background="Orange"
                                           Foreground="White"
                                           Name="PreLoadBox"
                                           VerticalAlignment="Center" />
            </StackPanel>
        </onePointControls:SettingExpander.Header>
        <onePointControls:SettingExpander.RightContent>
            <ToggleSwitch VerticalAlignment="Center"
                          Name="SettingModEnable"
                          IsCheckedChanged="SettingModEnable_OnIsCheckedChanged">
            </ToggleSwitch>
        </onePointControls:SettingExpander.RightContent>
        <StackPanel>
            <onePointControls:SettingCard Classes="NoBorder"
                                          Click="SettingBtn_OnClick"
                                          Header="模组加载配置"
                                          IsClickable="True"
                                          ToolTip.Tip="{DynamicResource Shared.Action.Settings}"
                                          Glyph="&#xE713;"
                                          Name="SettingBtn">
            </onePointControls:SettingCard>
            <onePointControls:SettingCard Classes="NoBorder"
                                          Click="DeleteBtn_OnClick"
                                          Header="删除模组"
                                          IsClickable="True"
                                          ToolTip.Tip="{DynamicResource Shared.Action.Delete}"
                                          Glyph="&#xE74D;"
                                          Name="DeleteBtn">
            </onePointControls:SettingCard>
        </StackPanel>
    </onePointControls:SettingExpander>
</UserControl>