<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:global="clr-namespace:BedrockBoot.Models.Global"
             xmlns:interopServices="clr-namespace:System.Runtime.InteropServices;assembly=System.Runtime"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.OtherPage.AboutPages.AboutPage">
    <ScrollViewer>
        <StackPanel Margin="20,15"
                    Spacing="8">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <Image Source="avares://BedrockBoot/Assets/Icon/BedrockBoot.Icon.256x.png"
                           Width="64"
                           Height="64"
                           HorizontalAlignment="Left" />

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <onePointControls:LineTextBlock Text="BedrockBoot"
                                                            Margin="12,0,0,0" />
                        </StackPanel>

                        <StackPanel Margin="12,0,0,0" 
                                    Spacing="8"
                                    Orientation="Horizontal"
                                    Opacity="0.8">
                            <TextBlock Text="{x:Static global:GlobalModel.BodyVersion}"></TextBlock>
                            
                            <TextBlock Name="PowerByTextBlock"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
            
            <onePointControls:SettingExpander Header="环境信息"
                                              Description="设备信息，运行环境，操作系统"
                                              IsExpanded="True"
                                              Glyph="&#xE946;">
                <StackPanel>
                    <onePointControls:SettingCard Header="本体版本"
                                                  Content="{x:Static global:GlobalModel.BodyVersion}"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="运行环境"
                                                  Content="{x:Static interopServices:RuntimeInformation.OSDescription}"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="运行时"
                                                  Content="{x:Static interopServices:RuntimeInformation.FrameworkDescription}"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="工作目录"
                                                  Content="{x:Static sys:Environment.CurrentDirectory}"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="设备名称"
                                                  Content="{x:Static sys:Environment.MachineName}"
                                                  Glyph=""></onePointControls:SettingCard>
                </StackPanel>
            </onePointControls:SettingExpander>
            
            <onePointControls:SettingExpander Header="鸣谢"
                                              Description="感谢以下服务以及项目对 BedrockBoot (本项目) 的支持"
                                              Glyph="&#xE7C1;">
                <StackPanel>
                    <onePointControls:SettingCard Header="McAppx.com"
                                                  Description="{DynamicResource About.Credits.MCAPPX}"
                                                  IsClickable="True"
                                                  Tag="https://www.mcappx.com/"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="github.akams.cn"
                                                  Description="{DynamicResource About.Credits.Akams}"
                                                  IsClickable="True"
                                                  Tag="https://github.akams.cn/"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="CurseForge"
                                                  Description="{DynamicResource About.Credits.CurseForge}"
                                                  IsClickable="True"
                                                  Tag="https://curseforge.com/"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="BMCBL"
                                                  Description="感谢来自 BMCBL 提供的 MCAPPX 列表源加速站点"
                                                  IsClickable="True"
                                                  Tag="https://bmcbl.chlna6666.com/"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                </StackPanel>
            </onePointControls:SettingExpander>
            
            <onePointControls:SettingExpander Header="灵感来源"
                                              Description="BedrockBoot 的部分灵感来源于以下项目"
                                              Glyph="&#xE734;">
                <StackPanel>
                    <onePointControls:SettingCard Header="BakaXL"
                                                  Description="BedrockBoot 内部分功能参考自 BakaXL"
                                                  IsClickable="True"
                                                  Tag="https://bakaxl.com/"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="BMCBL"
                                                  Description="BedrockBoot 内部分功能参考自 BMCBL"
                                                  IsClickable="True"
                                                  Tag="https://bmcbl.chlna6666.com/"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="LauncherX"
                                                  Description="{DynamicResource About.Inspiration.LauncherX}"
                                                  IsClickable="True"
                                                  Tag="https://corona.studio/lx"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="WonderLab"
                                                  Description="{DynamicResource About.Inspiration.WonderLab}"
                                                  IsClickable="True"
                                                  Tag="https://github.com/Lunova-Studio/WonderLab.Override"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="Polymerium"
                                                  Description="{DynamicResource About.Inspiration.Polymerium}"
                                                  IsClickable="True"
                                                  Tag="https://github.com/d3ara1n/Polymerium"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                </StackPanel>
            </onePointControls:SettingExpander>
            
            <onePointControls:SettingExpander Header="开发者"
                                              Description="BedrockBoot 的开发者以及技术支持"
                                              Glyph="&#xEC7A;">
                <StackPanel>
                    <onePointControls:SettingCard Header="Dime12022"
                                                  ImageIcon="avares://BedrockBoot/Assets/Image/Contributors/Dime12022.jpg"
                                                  IsFontIcon="False"
                                                  Classes="People"
                                                  Description="BedrockBoot 本体开发"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="YoumiHa"
                                                  ImageIcon="avares://BedrockBoot/Assets/Image/Contributors/YoumiHa.jpg"
                                                  IsFontIcon="False"
                                                  Classes="People"
                                                  Description="BedrockBoot 本体开发"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="DrMing (蛆)"
                                                  ImageIcon="avares://BedrockBoot/Assets/Image/Contributors/DrMing.jpg"
                                                  IsFontIcon="False"
                                                  Classes="People"
                                                  Description="UI 设计与交互体验"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="Chlna6666 (BMCBL)"
                                                  ImageIcon="avares://BedrockBoot/Assets/Image/Contributors/Chlna6666.jpg"
                                                  IsFontIcon="False"
                                                  Classes="People"
                                                  Description="通用协议策划与制定，为部分提供技术支持"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="Tianpao (天跑)"
                                                  ImageIcon="avares://BedrockBoot/Assets/Image/Contributors/Tianpao.jpg"
                                                  IsFontIcon="False"
                                                  Classes="People"
                                                  Description="网络设施技术支持，为 PaperConnect v2 提供技术支持"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="以及所有 BedrockBoot 贡献者"
                                                  Description="感谢所有为 BedrockBoot 贡献过代码、文档、设计、测试的开发者"
                                                  IsClickable="True"
                                                  Name="ContributorsBtn"
                                                  Click="ContributorsBtn_OnClick"
                                                  Glyph=""></onePointControls:SettingCard>
                </StackPanel>
            </onePointControls:SettingExpander>
            
            <onePointControls:SettingExpander Header="相关地址"
                                              Description="相关的项目地址、组织地址、问题反馈地址"
                                              Glyph="&#xE8A7;">
                <StackPanel>
                    <onePointControls:SettingCard Header="Github 开源"
                                                  Description="https://github.com/Round-Studio/BedrockBoot"
                                                  IsClickable="True"
                                                  Tag="https://github.com/Round-Studio/BedrockBoot"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="问题反馈"
                                                  Description="https://github.com/Round-Studio/BedrockBoot/issues"
                                                  IsClickable="True"
                                                  Tag="https://github.com/Round-Studio/BedrockBoot/issues"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="官方网站"
                                                  Description="https://bb.roundstudio.top"
                                                  IsClickable="True"
                                                  Tag="https://bb.roundstudio.top"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="文档站"
                                                  Description="https://docs.roundstudio.top/docs/product/bb"
                                                  IsClickable="True"
                                                  Tag="https://docs.roundstudio.top/docs/product/bb"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="隐私策略与使用条款"
                                                  Description="https://bb.roundstudio.top/privacyPolicy"
                                                  IsClickable="True"
                                                  Tag="https://bb.roundstudio.top/privacyPolicy"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="在爱发电上支持我们"
                                                  Description="您的支持是我们前进的动力"
                                                  IsClickable="True"
                                                  Tag="https://ifdian.net/a/yjq666"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                </StackPanel>
            </onePointControls:SettingExpander>

            <onePointControls:SettingCard Glyph="&#xE909;"
                                          Header="{DynamicResource About.Action.OpenSourceLib.Title}"
                                          Description="{DynamicResource About.Action.OpenSourceLib.Desc}"
                                          Name="OpenSourceBtn"
                                          Click="OpenSourceBtn_OnClick"
                                          IsClickable="True" />

            <onePointControls:SettingCard Glyph="&#xF4AA;"
                                          Name="VersionCard"
                                          Click="VersionCard_OnClick"
                                          IsClickable="True" 
                                          Header="{DynamicResource About.Action.Version.Title}"
                                          Description="{x:Static global:GlobalModel.BodyVersion}">
            </onePointControls:SettingCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>