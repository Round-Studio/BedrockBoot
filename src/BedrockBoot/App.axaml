<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BedrockBoot.App"
             xmlns:local="using:BedrockBoot"
             xmlns:core="clr-namespace:OnePointUI.Avalonia.Style.Core;assembly=OnePointUI.Avalonia"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <core:OnePointTheme AccentColor="#486860"
                            ThemeVariant="Dark" />
        <StyleInclude Source="avares://AsyncImageLoader.Avalonia/AdvancedImage.axaml" />
        <StyleInclude Source="avares://BedrockBoot/Style/Widgets/DesktopWidgetTemplated.axaml"/>
        <StyleInclude Source="avares://BedrockBoot/Style/Controls/AccountButton.axaml"/>
    </Application.Styles>
</Application>