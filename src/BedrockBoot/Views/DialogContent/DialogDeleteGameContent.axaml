<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d"
             x:Class="BedrockBoot.Views.DialogContent.DialogDeleteGameContent">
    <StackPanel Orientation="Horizontal">
        <onePointControls:ProgressRing Height="36" Width="36"
                                       Background="Transparent" />

        <StackPanel Margin="12,0,0,0"
                    VerticalAlignment="Center">
            <!-- 文案（含「进度：」前缀与两位小数）整条由 i18n 提供，避免前缀重复拼接 -->
            <TextBlock FontSize="16"
                       Name="DeleteProgressText"
                       Text="0.00 %" />


            <ProgressBar Name="DeleteProgressBar"
                         MinWidth="200"
                         Margin="0,8,0,0"
                         CornerRadius="3" />
        </StackPanel>
    </StackPanel>
</UserControl>