<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="600"
             x:Class="BedrockBoot.Views.Control.Widgets.AccountCard">
    <onePointControls:SettingExpander Name="Expander"
                                      IsFontIcon="False">
        <StackPanel>
            <onePointControls:SettingCard Header="{DynamicResource Account.Card.Manage}"
                                          Description="{DynamicResource Account.Card.Manage.Desc}"
                                          Glyph="&#xE713;"
                                          IsClickable="True"
                                          Click="ManageBtn_OnClick" />

            <onePointControls:SettingCard Header="{DynamicResource Account.Card.DeleteProfile}"
                                          Description="{DynamicResource Account.Card.DeleteProfile.Desc}"
                                          Glyph="&#xE74D;"
                                          IsClickable="True"
                                          Click="DeleteBtn_OnClick" />
        </StackPanel>
    </onePointControls:SettingExpander>
</UserControl>