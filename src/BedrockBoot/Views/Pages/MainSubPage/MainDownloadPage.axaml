<entry:BedrockBootPage xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
                 xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
                 xmlns:entry="clr-namespace:BedrockBoot.Base.Entry"
                 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                 x:Class="BedrockBoot.Views.Pages.MainSubPage.MainDownloadPage">
    <entry:BedrockBootPage.HeaderView>
        <Grid Width="400"
              HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"></ColumnDefinition>
                <ColumnDefinition Width="3*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            
            <DockPanel Grid.Column="0" 
                       LastChildFill="True">
                <onePointControls:FontIcon Glyph="&#xE721;"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           FontSize="18"
                                           Margin="5,0,10,0"
                                           VerticalAlignment="Center"/>
                
                <TextBox Margin="5,0"
                         VerticalAlignment="Center"
                         Height="32"
                         Name="TextBox"
                         TextChanged="TextBox_OnTextChanged"
                         HorizontalAlignment="Stretch"></TextBox>
            </DockPanel>
            
            <ComboBox Grid.Column="1" 
                      ClipToBounds="False"
                      Margin="5,0"
                      VerticalAlignment="Center"
                      Height="32"
                      SelectedIndex="1"
                      Name="ComboBox"
                      SelectionChanged="ComboBox_OnSelectionChanged"
                      VerticalContentAlignment="Center"
                      HorizontalAlignment="Stretch">
                <ComboBox.Items>
                    <ComboBoxItem Content="预览版"></ComboBoxItem>
                    <ComboBoxItem Content="正式版"></ComboBoxItem>
                    <ComboBoxItem Content="Beta 版"></ComboBoxItem>
                </ComboBox.Items>
            </ComboBox>
        </Grid>
    </entry:BedrockBootPage.HeaderView>
    <Grid>
        <notice:LoadCard HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         BigTitle="收集电子中..."
                         Message="全体电子，列队！"
                         Name="LoadingRing"></notice:LoadCard>
            
        <notice:InfoCard VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Glyph="&#xE822;"
                         BigTitle="请...诶？"
                         Message="您所输入的关键词无效哦"
                         Name="NoneBox"> </notice:InfoCard>
            
        <ScrollViewer Name="ScrollViewer">
            <StackPanel Name="ItemsPanel"
                        Margin="15,15,15,15"></StackPanel>
        </ScrollViewer>
    </Grid>
</entry:BedrockBootPage>
