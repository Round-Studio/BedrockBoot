<windowFrame:OnePointWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:windowFrame="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.WindowFrame;assembly=OnePointUI.Avalonia"
        xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="BedrockBoot.Views.Windows.ExceptionWindow"
        IsMaxBtn="False"
        IsMinBtn="False"
        WindowStartupLocation="CenterOwner"
        Width="800" Height="500"
        MinWidth="800" MinHeight="500"
        Title="BedrockBoot - 错误报告">
    
    <windowFrame:OnePointWindow.TitleBarContent>
        <onePointControls:LabelBox Text="异常处理"
                                   FontSize="14"
                                   Foreground="White"
                                   Background="DarkRed"
                                   Margin="0,0,5,0"
                                   VerticalAlignment="Center"/>
    </windowFrame:OnePointWindow.TitleBarContent>
    
    <windowFrame:OnePointWindow.MainContent>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 错误图标和标题 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="2,0,0,0">
                <onePointControls:FontIcon Glyph="&#xE814;" 
                                           FontSize="38" 
                                           Foreground="Orange"
                                           Margin="0,4,0,0"
                                           VerticalAlignment="Center"/>
                <onePointControls:LineTextBlock FontSize="28"
                                                FontWeight="Bold"
                                                VerticalAlignment="Center"
                                                Text="应用程序遇到了致命错误"/>
            </StackPanel>
            
            <!-- 错误消息 -->
            <TextBlock Grid.Row="1" 
                       Text="BedrockBoot 遇到了一个无法恢复的错误，需要关闭。"
                       Foreground="Gray"
                       Margin="0,5,0,15"/>
            
            <!-- 错误详情区域 -->
            <Border Grid.Row="2" 
                    Margin="0,0,0,20">
                
            </Border>
            
            <!-- 操作按钮 -->
            <StackPanel Grid.Row="3" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button Name="CopyButton"
                        Content="复制错误信息"
                        Padding="15,8"
                        MinWidth="120"
                        Classes="NoBorder"/>
                
                <Button Name="RestartButton"
                        Content="重新启动应用"
                        Padding="15,8"
                        MinWidth="120"
                        Classes="NoBorder"/>
                
                <Button Name="CloseButton"
                        Content="退出应用"
                        Padding="15,8"
                        MinWidth="120"
                        Classes="NoBorder"
                        Background="DarkRed"
                        Foreground="White"/>
            </StackPanel>
        </Grid>
    </windowFrame:OnePointWindow.MainContent>
</windowFrame:OnePointWindow>