<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Control.Widgets.DesktopWidgets.WidgetPreviewer">
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
            <StackPanel Grid.Column="0">
                <TextBlock FontSize="18"
                           Name="WidgetName"></TextBlock>
                <TextBlock Name="WidgetDescription"
                           Opacity="0.6"></TextBlock>
            </StackPanel>
            
            <Button Grid.Column="1"
                    Classes="NoBorder"
                    Name="AddBtn"
                    Click="AddBtn_OnClick"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <onePointControls:FontIcon VerticalAlignment="Center"
                                               Glyph="&#xE710;"/>
                    <TextBlock Text="添加此组件"></TextBlock>
                </StackPanel>
            </Button>
        </Grid>
        <Grid Grid.Row="1">
            <ContentControl Name="ContentControl"
                            HorizontalAlignment="Left"></ContentControl>
        </Grid>
    </Grid>
</UserControl>
