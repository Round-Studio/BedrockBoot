<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d"
             x:Class="BedrockBoot.Views.Control.Items.ArchiveItem">
    <items:BorderCard>
        <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0"
                    Name="ImageBox"
                    MinHeight="64"
                    MinWidth="120"
                    CornerRadius="6">
                <Border.Background>
                    <ImageBrush Stretch="UniformToFill"
                                Source="avares://BedrockBoot/Assets/Image/world-preview-flat-fixed-pixels.png" />
                </Border.Background>
                <Grid>
                    <onePointControls:LabelBox HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               Name="ProjectLabel"
                                               Margin="8"
                                               Text="{DynamicResource Shared.Label.Project}"
                                               FontSize="12"
                                               Background="Purple" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        Spacing="4">
                <TextBlock FontSize="15"
                           Name="WorldName">
                    My World
                </TextBlock>
                <TextBlock FontSize="11"
                           Opacity="0.8"
                           Name="WorldLastPlayed">
                    LastPlayed Time
                </TextBlock>

                <StackPanel Orientation="Horizontal"
                            Name="ControlPanel"
                            Spacing="6">
                    <Button Width="24" Height="24"
                            Name="EditBtn"
                            Click="EditBtn_OnClick"
                            Classes="NoBorder">
                        <onePointControls:FontIcon Glyph="&#xE713;" />
                    </Button>

                    <Button Width="24" Height="24"
                            Name="OpenFolderBtn"
                            Click="OpenFolderBtn_OnClick"
                            ToolTip.Tip="{DynamicResource Shared.Action.OpenFolder}"
                            Classes="NoBorder">
                        <onePointControls:FontIcon Glyph="&#xE8B7;" />
                    </Button>

                    <Button Width="24" Height="24"
                            Name="SaveBtn"
                            Click="SaveBtn_OnClick"
                            ToolTip.Tip="{DynamicResource Shared.Action.Save}"
                            Classes="NoBorder">
                        <onePointControls:FontIcon Glyph="&#xE74E;" />
                    </Button>

                    <Button Width="24" Height="24"
                            Name="DeleteBtn"
                            Click="DeleteBtn_OnClick"
                            Classes="NoBorder">
                        <onePointControls:FontIcon Glyph="&#xE74D;"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </items:BorderCard>
</UserControl>