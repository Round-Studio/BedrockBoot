<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400"
             x:Class="BedrockBoot.Views.Control.GameItem">
    <onePointControls:SettingCard IsClickable="True"
                                  Name="Card"
                                  Margin="0,0,0,10"
                                  Glyph="&#xE7FC;"
                                  Header="VersionName"
                                  Description="Release Version">
        <Button Padding="12,8"
                Classes="Accent"
                Name="LaunchBtn"
                Click="LaunchBtn_OnClick">启动</Button>
    </onePointControls:SettingCard>
</UserControl>
