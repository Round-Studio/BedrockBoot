<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800"
             x:Class="BedrockBoot.Views.TaskItem.TaskDownloadDllModItem">
    <items:BorderCard>
        <Grid ColumnDefinitions="Auto,*,Auto">
            <onePointControls:FontIcon Grid.Column="0"
                                       Glyph="&#xE896;"
                                       VerticalAlignment="Top"
                                       Margin="4,4,0,0"
                                       FontSize="28">
            </onePointControls:FontIcon>

            <StackPanel Grid.Column="1" Margin="15,0,10,0"
                        HorizontalAlignment="Stretch">
                <TextBlock FontSize="16"
                           Name="CardTitle"
                           Text="下载 DllMod" />

                <StackPanel Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Name="SourceListBox">
                    <DockPanel>
                        <TextBlock Text="0%"
                                   MinWidth="80"
                                   Name="ProgressText" />

                        <ProgressBar Name="ProgressBar"
                                     IsIndeterminate="True" />
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </items:BorderCard>
</UserControl>