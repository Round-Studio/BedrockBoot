<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="60"
             x:Class="BedrockBoot.Views.Control.Widgets.CopyTextBox"
             x:Name="Root">
    <DockPanel HorizontalSpacing="8"
               LastChildFill="True">
        <Button x:Name="CopyButton"
                Classes="NoBorder"
                Width="32" Height="32"
                DockPanel.Dock="Right"
                Click="CopyButton_Click">
            <onePointControls:FontIcon Glyph="&#xE8C8;"/>
        </Button>
        <TextBox x:Name="MainTextBox"
                 DockPanel.Dock="Left"
                 TextChanged="MainTextBox_TextChanged"/>
    </DockPanel>
</UserControl>