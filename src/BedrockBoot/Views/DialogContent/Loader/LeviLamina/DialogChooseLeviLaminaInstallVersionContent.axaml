<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="BedrockBoot.Views.DialogContent.Loader.LeviLamina.DialogChooseLeviLaminaInstallVersionContent">
    <StackPanel Spacing="8">
        <ComboBox Width="300"
                  Name="ComboBox">
        </ComboBox>

        <TextBlock Text="选择一个适合该实例版本的 LeviLamina 版本以进行安装"
                   Opacity="0.6">
        </TextBlock>
    </StackPanel>
</UserControl>