<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="BedrockBoot.Views.DialogContent.DialogAddGameFolderContent">
    <StackPanel>
        <TextBlock Margin="0,5,0,5"
                   HorizontalAlignment="Left">目录名（自定义）：</TextBlock>
        <TextBox Margin="0,5,0,5" Width="320"
                 Name="PathNameInputBox"></TextBox>
        <TextBlock Margin="0,5,0,5"
                   HorizontalAlignment="Left">目录路径：</TextBlock>
        <DockPanel>
            <Button DockPanel.Dock="Right"
                    Margin="5,5,0,5"
                    Padding="12,0"
                    Classes="NoBorder"
                    Name="OpenChooseFolderBtn"
                    Click="OpenChooseFolderBtn_OnClick">浏览</Button>
            
            <TextBox Margin="0,5,5,5"
                     Name="PathInputBox"></TextBox>
        </DockPanel>
    </StackPanel>
</UserControl>
