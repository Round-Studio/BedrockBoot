<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800"
             x:Class="BedrockBoot.Views.Control.Items.LevelStructureItem">
    <items:BorderCard>
        <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0"
                    Width="64"
                    Height="64"
                    CornerRadius="6">
                <Border.Background>
                    <ImageBrush Stretch="UniformToFill"
                                Source="avares://BedrockBoot/Assets/Image/world-preview-flat-fixed-pixels.png" />
                </Border.Background>
                <Panel>
                    <Border Background="#90000000"
                            CornerRadius="6" />
                    <onePointControls:FontIcon Glyph="&#xF158;"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="White" />
                </Panel>
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        Spacing="4">
                <TextBlock FontSize="15"
                           Name="StructureName"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="11"
                           Opacity="0.8"
                           Name="StructureInfo"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="11"
                           Opacity="0.6"
                           Name="StructurePath"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12,0"
                        Spacing="6">
                <Button Width="24" Height="24"
                        Name="ExportBtn"
                        Click="ExportBtn_OnClick"
                        ToolTip.Tip="{DynamicResource Shared.Action.Save}"
                        Classes="NoBorder">
                    <onePointControls:FontIcon Glyph="&#xE74E;" />
                </Button>

                <Button Width="24" Height="24"
                        Name="DeleteBtn"
                        Click="DeleteBtn_OnClick"
                        ToolTip.Tip="{DynamicResource Shared.Action.Delete}"
                        Classes="NoBorder">
                    <onePointControls:FontIcon Glyph="&#xE74D;"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                </Button>
            </StackPanel>
        </Grid>
    </items:BorderCard>
</UserControl>
