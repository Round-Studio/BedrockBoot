<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             xmlns:navigation="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.MainPage">
    <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0"
                   Margin="20,15,0,0"
                   VerticalAlignment="Center"
                   FontSize="28"
                   FontWeight="Heavy">你好，欢迎回来！</TextBlock>
        
        <items:BorderCard Grid.Row="0"
                          Margin="20,20,20,5"
                          MaxHeight="48"
                          HorizontalAlignment="Right">
            <TabControl Margin="0,2,0,0">
                <TabItem Header="主页"></TabItem>
                <TabItem Header="实例"></TabItem>
                <TabItem Header="下载"></TabItem>
                <TabItem Header="设置"></TabItem>
            </TabControl>
        </items:BorderCard>
        
        <navigation:NavigationFrame Grid.Row="1"
                                    Name="MainFrame"/>
    </Grid>
</UserControl>
