<entry1:BedrockBootPage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
                       xmlns:navigation="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation;assembly=OnePointUI.Avalonia"
                       xmlns:entry1="clr-namespace:BedrockBoot.Base.Entry;assembly=BedrockBoot.Base"
                       mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                       x:Class="BedrockBoot.Views.Pages.MainSubPage.MainDownloadPage">
    <entry1:BedrockBootPage.HeaderView>
        <Grid Width="400"
              HorizontalAlignment="Left">
            <onePointControls:LineTextBlock Grid.Column="0"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            FontSize="28"
                                            FontWeight="Bold"
                                            Text="下载" />
        </Grid>
    </entry1:BedrockBootPage.HeaderView>
    <Grid>
        <navigation:NavigationFrame Name="NavFrame" />
    </Grid>
</entry1:BedrockBootPage>