<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800"
             x:Class="BedrockBoot.Views.Control.Items.Instance.ModLoaderItem">
    <onePointControls:SettingExpander Name="LoaderCard"
                                      Glyph="&#xEA86;"
                                      Description="Loader Description">
        <onePointControls:SettingExpander.Header>
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <TextBlock Name="LoaderName"
                           Text="LoaderName">
                </TextBlock>

                <onePointControls:LabelBox Name="LoaderInstallStatus"
                                           VerticalAlignment="Center"
                                           Text="未安装">
                </onePointControls:LabelBox>
            </StackPanel>
        </onePointControls:SettingExpander.Header>
        <onePointControls:SettingExpander.RightContent>
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <onePointControls:LabelBox Text="不适用"
                                           FontSize="14"
                                           Background="DarkRed"
                                           Name="NotApplicableLabel"
                                           IsVisible="False"
                                           VerticalAlignment="Center">
                </onePointControls:LabelBox>
                <Button Name="InstallBtn"
                        VerticalAlignment="Center"
                        Height="32"
                        Padding="18,2"
                        IsVisible="False"
                        Background="{DynamicResource AccentBackgroundBrush}"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        Click="InstallBtn_OnClick">
                </Button>
                <onePointControls:ProgressRing Name="LoadingRing"></onePointControls:ProgressRing>
                <ToggleSwitch VerticalAlignment="Center"
                              Name="IsEnableToggle"
                              IsCheckedChanged="IsEnableToggle_OnIsCheckedChanged"
                              IsVisible="False">
                </ToggleSwitch>
            </StackPanel>
        </onePointControls:SettingExpander.RightContent>
        <StackPanel>
            <onePointControls:SettingCard Name="ViewDetailBtn"
                                          Header="查看详情"
                                          Glyph="&#xE8A7;"
                                          IsClickable="True">
            </onePointControls:SettingCard>
            <onePointControls:SettingCard Name="DeleteBtn"
                                          Header="移除该加载器"
                                          Glyph="&#xE74D;"
                                          IsClickable="True"
                                          IsVisible="False">
            </onePointControls:SettingCard>
        </StackPanel>
    </onePointControls:SettingExpander>
</UserControl>