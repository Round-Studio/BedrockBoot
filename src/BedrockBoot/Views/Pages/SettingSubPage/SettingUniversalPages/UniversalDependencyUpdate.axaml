<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.SettingSubPage.SettingUniversalPages.UniversalDependencyUpdate">
    <ScrollViewer>
        <!-- 边距与同级页面 (UniversalDebug / UniversalSoftwareUpdate) 保持一致：
             面板 Margin="20,15"，卡片与标题不再叠加额外边距 -->
        <StackPanel Margin="20,15"
                    Spacing="8">
            <TextBlock FontWeight="Bold"
                       FontSize="14"
                       Text="联机依赖组件" />

            <onePointControls:SettingCard Name="EasyTierCard"
                                          Header="EasyTier"
                                          Description="正在读取版本信息..."
                                          IsShowActionIcon="False"
                                          Glyph="&#xE968;">
                <TextBlock Name="EasyTierLatestText"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           Text="" />
            </onePointControls:SettingCard>

            <onePointControls:SettingCard Name="GravityConeCard"
                                          Header="GravityCone"
                                          Description="正在读取版本信息..."
                                          IsShowActionIcon="False"
                                          Glyph="&#xE774;">
                <TextBlock Name="GravityConeLatestText"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           Text="" />
            </onePointControls:SettingCard>

            <TextBlock FontWeight="Bold"
                       FontSize="14"
                       Text="操作" />

            <onePointControls:SettingCard Name="CheckCard"
                                          Header="检查更新"
                                          Description="从 GitHub 获取联机组件的最新版本并与本地版本比对"
                                          IsShowActionIcon="False"
                                          Glyph="&#xE895;">
                <Button Padding="8"
                        Height="36"
                        MinWidth="100"
                        Name="CheckUpdateBtn"
                        Content="检查更新"
                        Click="CheckUpdateBtn_OnClick" />
            </onePointControls:SettingCard>

            <onePointControls:SettingCard Name="UpdateCard"
                                          IsVisible="False"
                                          Header="更新依赖"
                                          Description="下载并安装最新版本的联机组件（更新期间联机功能将被关闭）"
                                          IsShowActionIcon="False"
                                          Glyph="&#xE896;">
                <Button Padding="8"
                        Height="36"
                        MinWidth="100"
                        Name="UpdateBtn"
                        Content="立即更新"
                        Click="UpdateBtn_OnClick" />
            </onePointControls:SettingCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
