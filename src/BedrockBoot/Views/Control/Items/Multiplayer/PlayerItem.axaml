<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800"
             x:Class="BedrockBoot.Views.Control.Items.Multiplayer.PlayerItem">
    <onePointControls:SettingCard Name="Card"
                                  Glyph="&#xE77B;"
                                  Description="id">
        <onePointControls:SettingCard.Header>
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <TextBlock Name="PlayerName"
                           Text="Name"></TextBlock>
                <onePointControls:LabelBox Name="HostBox"
                                           Text="房主"
                                           Foreground="White"
                                           FontSize="12"></onePointControls:LabelBox>
            </StackPanel>
        </onePointControls:SettingCard.Header>
    </onePointControls:SettingCard>
</UserControl>
