<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" MinWidth="160"
             x:Class="BedrockBoot.Views.Control.Widgets.XboxUserInfoWidget">
    <Grid>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Name="BoxContent"
                    IsVisible="False"
                    Spacing="8">
            <onePointControls:FontIcon Glyph="&#xE77B;"
                                       VerticalAlignment="Center"
                                       FontSize="22" />

            <StackPanel>
                <TextBlock Opacity="0.6"
                           Text="Xbox Live" />

                <TextBlock Text="PlayerName"
                           Name="PlayerName"
                           FontSize="18" />
            </StackPanel>
        </StackPanel>

        <onePointControls:ProgressRing HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Name="LoadRing" />
    </Grid>
</UserControl>