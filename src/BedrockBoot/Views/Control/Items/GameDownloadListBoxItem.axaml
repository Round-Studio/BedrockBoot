<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:widgets="clr-namespace:BedrockBoot.Views.Control.Widgets"
             mc:Ignorable="d" d:DesignWidth="800"
             x:Class="BedrockBoot.Views.Control.Items.GameDownloadListBoxItem">
    <Grid ColumnDefinitions="Auto,*"
          Margin="0,8"
          ColumnSpacing="8">
        <widgets:LocalImageRenderWidget Grid.Column="0"
                                        Name="IconBox"
                                        Width="36"
                                        Height="36"/>
        
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center">
            <TextBlock Text="Version"
                       FontSize="16"
                       Name="VersionName"></TextBlock>
            <TextBlock Text="VersionD"
                       Opacity="0.6"
                       Name="VersionD"></TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
