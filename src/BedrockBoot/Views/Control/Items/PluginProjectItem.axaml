<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Control.Items.PluginProjectItem">
    <onePointControls:SettingCard IsClickable="True"
                                  Name="Card"
                                  Margin="5,0"
                                  Click="Card_OnClick"
                                  IsShowActionIcon="True"
                                  Glyph="&#xEA86;">
        <onePointControls:SettingCard.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Plugin Name" Name="NameBox" />
                <onePointControls:LabelBox Text="Version"
                                           Name="VersionBox"
                                           VerticalAlignment="Center" />
            </StackPanel>
        </onePointControls:SettingCard.Header>

        <onePointControls:SettingCard.Description>
            <TextBlock Text="Plugin Description" Name="DescriptionBox" TextWrapping="Wrap" />
        </onePointControls:SettingCard.Description>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="DeleteButton"
                    Classes="NoBorder"
                    Padding="8"
                    Click="DeleteButton_OnClick"
                    VerticalAlignment="Center">
                <onePointControls:FontIcon Glyph="&#xE74D;"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           FontSize="16" />
            </Button>
        </StackPanel>
    </onePointControls:SettingCard>
</UserControl>
