<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:global="clr-namespace:BedrockBoot.Models.Global"
             xmlns:widgets="clr-namespace:BedrockBoot.Views.Control.Widgets"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.OtherPage.AboutPages.AboutReleaseNotes">
    <UserControl.Styles>
        <Styles>
            <Style Selector="TextBlock">
                <Setter Property="TextWrapping"
                        Value="WrapWithOverflow"></Setter>
            </Style>
        </Styles>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel Margin="20"
                    Spacing="2">
            <TextBlock Text="{x:Static global:GlobalModel.BodyVersion}"
                       FontSize="28"
                       FontWeight="Heavy"></TextBlock>
            
            <TextBlock Text="{DynamicResource About.ReleaseNotes.CurrentVersion}"
                       Margin="0,0,0,8"
                       Opacity="0.8"></TextBlock>
            
            <TextBlock Text="{DynamicResource About.ReleaseNotes.ReleasedVersion}"
                       Margin="0,8,0,0"
                       FontSize="16"
                       FontWeight="Bold"></TextBlock>
            
            <TextBlock Text="{DynamicResource About.ReleaseNotes.LTSNotice}"
                       Opacity="0.8"></TextBlock>
            
            <TextBlock Text="{DynamicResource About.ReleaseNotes.AbbrevNotice}"
                       Opacity="0.8"></TextBlock>
            
            <TextBlock Text="{DynamicResource About.ReleaseNotes.CrossPlatform}"
                       Margin="0,8,0,0"
                       FontSize="16"
                       FontWeight="Bold"></TextBlock>
            
            <items:BorderCard Width="320" Height="180"
                              Margin="0,8"
                    HorizontalAlignment="Left"
                    Padding="0"
                    CornerRadius="6">
                <Border CornerRadius="6">
                    <Border.Background>
                        <ImageBrush Source="avares://BedrockBoot/Assets/Image/About/CrossPlatform.png"></ImageBrush>
                    </Border.Background>
                </Border>
            </items:BorderCard>
            
            <TextBlock Text="{DynamicResource About.ReleaseNotes.AvaloniaDesc}"
                       Opacity="0.8"></TextBlock>
            
            <TextBlock Text="{DynamicResource About.ReleaseNotes.PlatformSupport}"
                       Opacity="0.8"></TextBlock>
            
            <TextBlock Text="{DynamicResource About.ReleaseNotes.LinuxLimit}"
                       Opacity="0.8"></TextBlock>
            
            <TextBlock Text="{DynamicResource About.ReleaseNotes.LinuxLogin}"
                       Opacity="0.8"></TextBlock>
            
            <TextBlock Text="{DynamicResource About.ReleaseNotes.Multiplayer}"
                       Margin="0,8,0,0"
                       FontSize="16"
                       FontWeight="Bold"></TextBlock>
            
            <TextBlock Text="{DynamicResource About.ReleaseNotes.PaperConnect}"
                       Opacity="0.8"></TextBlock>
            
            <TextBlock Text="{DynamicResource About.ReleaseNotes.MoreFeatures}"
                       Margin="0,8,0,0"
                       FontSize="16"
                       FontWeight="Bold"></TextBlock>
            
            <TextBlock Text="{DynamicResource About.ReleaseNotes.ToolsDesc}"
                       Opacity="0.8"></TextBlock>
            
            <TextBlock Text="{DynamicResource About.ReleaseNotes.ResourceMgmt}"
                       Opacity="0.8"></TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
