<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800"
             x:Class="BedrockBoot.Views.Control.Items.Download.ResourceFileItem">
    <Grid>
        <onePointControls:SettingCard IsClickable="True"
                                      Name="Card"
                                      Glyph=""
                                      IsShowActionIcon="False"
                                      Header="Name">
            <StackPanel Orientation="Horizontal"
                        Height="32"
                        Spacing="8">
                <Button Classes="NoBorder"
                        Name="SaveBtn"
                        Width="32"
                        Click="SaveBtn_OnClick"
                        ToolTip.Tip="{DynamicResource Shared.Action.Save}"
                        Padding="8">
                    <onePointControls:FontIcon Glyph="&#xE74E;"
                                               FontSize="14" />
                </Button>
                <Button Classes="NoBorder"
                        Padding="16,0"
                        Name="DownloadBtn"
                        Click="DownloadBtn_OnClick"
                        Background="{DynamicResource AccentBackgroundBrush}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <onePointControls:FontIcon Glyph="&#xE896;"
                                                   VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Shared.Action.Download}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </onePointControls:SettingCard>

        <onePointControls:SettingExpander Name="Expander"
                                          Glyph="&#xE7C3;"
                                          IsVisible="False">
            <onePointControls:SettingExpander.Header>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <onePointControls:LabelBox Name="ReleaseTypeTag" 
                                               VerticalAlignment="Center"/>
                    <TextBlock Name="FileNameHeader" VerticalAlignment="Center" />
                </StackPanel>
            </onePointControls:SettingExpander.Header>
            <onePointControls:SettingExpander.Description>
                <TextBlock Name="FileSummary" FontSize="11" Opacity="0.8" />
            </onePointControls:SettingExpander.Description>
            <StackPanel>
                <onePointControls:SettingCard Header="{DynamicResource Download.CurseForge.File.DownloadCount}"
                                              Name="DownloadCountCard"
                                              Glyph="">
                    <TextBlock Name="DownloadCountText" />
                </onePointControls:SettingCard>
                <onePointControls:SettingCard Header="{DynamicResource Download.CurseForge.File.FileName}"
                                              Name="FileNameCard"
                                              Glyph="">
                    <TextBlock Name="FileNameText" />
                </onePointControls:SettingCard>
                <onePointControls:SettingCard Header="{DynamicResource Download.CurseForge.File.SupportedVersions}"
                                              Glyph="">
                        <WrapPanel Name="VersionsPanel"
                                   HorizontalAlignment="Stretch"
                                   MaxWidth="720" />
                </onePointControls:SettingCard>
                <onePointControls:SettingCard Header="{DynamicResource Shared.Action.Download}"
                                              Glyph="">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Classes="NoBorder" Name="ExpanderSaveBtn" Width="32" Click="SaveBtn_OnClick"
                                ToolTip.Tip="{DynamicResource Shared.Action.Save}" Padding="8">
                            <onePointControls:FontIcon Glyph="&#xE74E;" FontSize="14" />
                        </Button>
                        <Button Classes="NoBorder" Padding="16,0" Name="ExpanderDownloadBtn"
                                Click="DownloadBtn_OnClick" Background="{DynamicResource AccentBackgroundBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <onePointControls:FontIcon Glyph="&#xE896;" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Shared.Action.Download}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </onePointControls:SettingCard>
            </StackPanel>
        </onePointControls:SettingExpander>
    </Grid>
</UserControl>
