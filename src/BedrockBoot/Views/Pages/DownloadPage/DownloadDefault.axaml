<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.DownloadPage.DownloadDefault">
    <StackPanel Spacing="10">
        <items:BorderCard>
            <Grid RowDefinitions="*,Auto">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,*">
                    <Button Grid.Column="0" 
                            Classes="NoBorder"
                            HorizontalContentAlignment="Stretch"
                            Padding="4">
                        <Grid ColumnDefinitions="Auto,*"
                              Margin="2,0">
                            <Image Grid.Column="0"
                                   Width="26"
                                   Height="26"
                                   Source="avares://Round.Avalonia.Assets/Image/Icon/mc_grassblock_neo.png"></Image>
                            
                            <StackPanel Grid.Column="1"
                                        Margin="5,-1,0,1"
                                        HorizontalAlignment="Stretch">
                                <TextBlock Text="Version"></TextBlock>
                                <TextBlock Text="Date"
                                           FontSize="9"
                                           Opacity="0.6"></TextBlock>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" 
                            Classes="NoBorder"
                            HorizontalContentAlignment="Stretch"
                            Padding="4">
                        <Grid ColumnDefinitions="Auto,*"
                              Margin="2,0">
                            <Image Grid.Column="0"
                                   Width="26"
                                   Height="26"
                                   Source="avares://Round.Avalonia.Assets/Image/Icon/mc_grassblock_neo.png"></Image>
                            
                            <StackPanel Grid.Column="1"
                                        Margin="5,-1,0,1"
                                        HorizontalAlignment="Stretch">
                                <TextBlock Text="Version"></TextBlock>
                                <TextBlock Text="Date"
                                           FontSize="9"
                                           Opacity="0.6"></TextBlock>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </items:BorderCard>
    </StackPanel>
</UserControl>
