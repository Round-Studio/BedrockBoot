<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:bedrockBoot="clr-namespace:BedrockBoot"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.SettingSubPage.SettingUniversalPages.UniversalLanguage">
    <ScrollViewer>
        <StackPanel Margin="20,15"
                    Spacing="8">
            <items:BorderCard Padding="0">
                <Grid>
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            ClipToBounds="True"
                            CornerRadius="6">
                        <onePointControls:FontIcon FontSize="168"
                                                   Opacity="0.2"
                                                   Glyph="&#xE909;"
                                                   Margin="0,-50,-4,0"></onePointControls:FontIcon>
                    </Border>
                    <Grid Margin="24">
                        <StackPanel>
                            <TextBlock FontSize="22"
                                       Text="让"></TextBlock>
                            <TextBlock FontSize="42"
                                       FontWeight="DemiBold"
                                       Text="BedrockBoot"></TextBlock>
                            <TextBlock FontSize="22"
                                       Text="走向国际化。"></TextBlock>
                            
                            <StackPanel Margin="0,16,0,0"
                                        Spacing="4">
                                <TextBlock Text="在社区的共同助力下，BedrockBoot 正在迈向国际化的新篇章。"></TextBlock>
                                <TextBlock Text="欢迎各位贡献者前来参与本地化贡献，与我们一同完善多语言支持，为 BedrockBoot 更好地服务全球用户的目标添砖加瓦。"></TextBlock>
                                <TextBlock Text="感谢每一位参与 BedrockBoot 国际化，参与翻译、校对与改进的贡献者！"></TextBlock>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,8,0,0">
                                <Button Padding="22,8"
                                        Content="提交 Pull Request"
                                        Name="OpenPRBtn"
                                        Click="OpenPRBtn_OnClick"></Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </items:BorderCard>
            
            <TextBlock FontWeight="Bold"
                       FontSize="14"
                       Text="显示语言" />

            <ComboBox HorizontalAlignment="Stretch"
                      Name="LanguageSelectBox"
                      SelectionChanged="LanguageSelectBox_OnSelectionChanged"
                      ItemsSource="{x:Static bedrockBoot:I18nManager.LanguageDict}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{ReflectionBinding Value.DisplayName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            
            <TextBlock Opacity="0.8"
                       TextWrapping="WrapWithOverflow"
                       Text="BedrockBoot 支持多个地区/国家的语言。" />
            
            <TextBlock FontWeight="Bold"
                       FontSize="14"
                       Text="来源 / 翻译官" />
            
            <TextBlock Opacity="0.8"
                       TextWrapping="WrapWithOverflow"
                       Text="{DynamicResource LanguageName}" />
            
            <TextBlock FontWeight="Bold"
                       FontSize="14"
                       Text="本地化工具" />
            
            <onePointControls:SettingCard Header="本地化调试工具"
                                          Description="临时挂载本地化文件"
                                          Glyph="&#xF196;"
                                          Name="LocalFileBtn"
                                          Click="LocalFileBtn_OnClick"
                                          IsClickable="True"></onePointControls:SettingCard>
            
            <TextBlock Opacity="0.8"
                       TextWrapping="WrapWithOverflow"
                       Text="在本次运行时使用本地的语言文件替换所选的语言。" />
            
            <TextBlock Opacity="0.8"
                       TextWrapping="WrapWithOverflow"
                       Text="该调试工具支持语言文件热重载。" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
