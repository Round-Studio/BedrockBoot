<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="600"
             x:Class="BedrockBoot.Views.Control.Widgets.AccountCard">
    <onePointControls:SettingExpander Name="Expander"
                                      IsFontIcon="False">
        <StackPanel>
            <onePointControls:SettingCard Header="管理此账户"
                                          Description="查看并管理此账户的档案信息"
                                          Glyph="&#xE713;"
                                          IsClickable="True"
                                          Click="ManageBtn_OnClick" />

            <onePointControls:SettingCard Header="删除此档案"
                                          Description="在启动器中删除此账户档案"
                                          Glyph="&#xE74D;"
                                          IsClickable="True"
                                          Click="DeleteBtn_OnClick" />
        </StackPanel>
    </onePointControls:SettingExpander>
</UserControl>