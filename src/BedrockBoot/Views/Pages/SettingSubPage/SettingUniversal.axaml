<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.SettingSubPage.SettingUniversal">
    <ScrollViewer>
        <StackPanel Margin="15"
                    Spacing="8">
            <TextBlock Margin="5, 0"
                       FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Settings.Universal.Group.Accessibility}" />

            <onePointControls:SettingCard Margin="5, 0"
                                          Header="{DynamicResource Settings.Universal.JumpList.Title}"
                                          Description="{DynamicResource Settings.Universal.JumpList.Desc}"
                                          Glyph="&#xE8FC;">
                <ToggleSwitch IsChecked="False"
                              Name="TaskBarJumpItem"
                              IsCheckedChanged="TaskBarJumpItem_OnIsCheckedChanged" />
            </onePointControls:SettingCard>

            <TextBlock Margin="5, 0"
                       FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Settings.Download.Group.Advanced}" />

            <onePointControls:SettingCard Margin="5, 0"
                                          Header="{DynamicResource Settings.Download.SoftwareUpdate.Title}"
                                          Description="{DynamicResource Settings.Download.SoftwareUpdate.Desc}"
                                          IsClickable="True"
                                          Name="SoftwareUpdate"
                                          Click="SoftwareUpdate_OnClick"
                                          Glyph="&#xE895;" />

            <onePointControls:SettingCard Margin="5, 0"
                                          Header="{DynamicResource Settings.Universal.Debug.Title}"
                                          Description="{DynamicResource Settings.Universal.Debug.Desc}"
                                          IsClickable="True"
                                          Name="DebugBtn"
                                          Click="DebugBtn_OnClick"
                                          Glyph="&#xEBE8;" />
        </StackPanel>
    </ScrollViewer>
</UserControl>