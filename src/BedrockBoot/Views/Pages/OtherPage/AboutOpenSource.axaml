<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.OtherPage.AboutOpenSource">
    <ScrollViewer>
        <StackPanel Margin="15">
            <TextBlock FontSize="22"
                       FontWeight="Bold"
                       Margin="5,20,5,8">
                Avalonia
            </TextBlock>
            <TextBlock Margin="5,5,0,0" Name="AvaloniaVersion" />
            <TextBlock Margin="5" Text="(https://github.com/AvaloniaUI/Avalonia)" />
            <TextBlock Margin="5" FontSize="9" Text="{DynamicResource About.OpenSource.License.Mit}" />
            <TextBlock Margin="5" FontSize="9" Text="(https://github.com/AvaloniaUI/Avalonia/blob/master/licence.md)" />


            <TextBlock FontSize="22"
                       FontWeight="Bold"
                       Margin="5,20,5,8">
                OnePointUI.Avalonia
            </TextBlock>
            <TextBlock Margin="5" Text="(https://github.com/Round-Studio/OnePointUI.Avalonia)" />
            <TextBlock Margin="5" FontSize="9" Text="{DynamicResource About.OpenSource.License.Mit}" />
            <TextBlock Margin="5" FontSize="9" Text="(https://github.com/Round-Studio/OnePointUI.Avalonia/blob/master/LICENSE)" />


            <TextBlock FontSize="22"
                       FontWeight="Bold"
                       Margin="5,20,5,8">
                Round.SDK
            </TextBlock>
            <TextBlock Margin="5" Text="(https://github.com/Round-Studio/Round.SDK)" />
            <TextBlock Margin="5" FontSize="9" Text="{DynamicResource About.OpenSource.License.Gpl}" />
            <TextBlock Margin="5" FontSize="9" Text="(https://github.com/Round-Studio/Round.SDK/blob/master/LICENSE)" />


            <TextBlock FontSize="22"
                       FontWeight="Bold"
                       Margin="5,20,5,8">
                BedrockLauncher.Core
            </TextBlock>
            <TextBlock Margin="5" Text="(https://github.com/Round-Studio/BedrockLauncher.Core)" />
            <TextBlock Margin="5" FontSize="9" Text="{DynamicResource About.OpenSource.License.Mit}" />
            <TextBlock Margin="5" FontSize="9" Text="(https://github.com/Round-Studio/BedrockLauncher.Core/blob/2.0-main/LICENSE)" />


            <TextBlock FontSize="22"
                       FontWeight="Bold"
                       Margin="5,20,5,8">
                PeNet
            </TextBlock>
            <TextBlock Margin="5" Text="(https://github.com/secana/PeNet)" />
            <TextBlock Margin="5" Text="(https://github.com/Round-Studio/PeNet)" />
            <TextBlock Margin="5" FontSize="9" Text="{DynamicResource About.OpenSource.License.Apache}" />
            <TextBlock Margin="5" FontSize="9" Text="(https://github.com/secana/PeNet/blob/master/LICENSE)" />


            <TextBlock FontSize="22"
                       FontWeight="Bold"
                       Margin="5,20,5,8">
                Octokit
            </TextBlock>
            <TextBlock Margin="5" Text="(https://github.com/octokit/octokit.net)" />
            <TextBlock Margin="5" FontSize="9" Text="{DynamicResource About.OpenSource.License.Mit}" />
            <TextBlock Margin="5" FontSize="9" Text="(https://github.com/octokit/octokit.net/blob/main/LICENSE.txt)" />


            <TextBlock FontSize="22"
                       FontWeight="Bold"
                       Margin="5,20,5,8">
                Windows.APICodePack
            </TextBlock>
            <TextBlock Margin="5" Text="(https://github.com/contre/Windows-API-Code-Pack-1.1)" />
            <TextBlock Margin="5" FontSize="9" Text="{DynamicResource About.OpenSource.License.Custom}" />
            <TextBlock Margin="5" FontSize="9" Text="(https://github.com/contre/Windows-API-Code-Pack-1.1/blob/main/LICENSE)" />


            <TextBlock FontSize="22"
                       FontWeight="Bold"
                       Margin="5,20,5,8">
                WindowsCommunityToolkit (Microsoft.Toolkit.Uwp.Notifications)
            </TextBlock>
            <TextBlock Margin="5" Text="(https://github.com/CommunityToolkit/WindowsCommunityToolkit)" />
            <TextBlock Margin="5" FontSize="9" Text="{DynamicResource About.OpenSource.License.Mit}" />
            <TextBlock Margin="5" FontSize="9" Text="(https://github.com/CommunityToolkit/WindowsCommunityToolkit/blob/main/License.md)" />
        </StackPanel>
    </ScrollViewer>
</UserControl>