<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.InstanceSubPage.DrawContent.InstanceSetting">
    <ScrollViewer>
        <StackPanel Margin="20,0,20,15"
                    Spacing="8">
            <TextBlock FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Instance.Info.Group.Launch}" />

            <onePointControls:SettingCard Glyph="&#xEC06;"
                                          Header="{DynamicResource Instance.Info.Launch.Args.Title}"
                                          Description="{DynamicResource Instance.Info.Launch.Args.Desc}">
                <TextBox Width="200"
                         Name="InstanceArgs"
                         TextChanged="TextTypeConfig_OnChanged" />
            </onePointControls:SettingCard>

            <onePointControls:SettingCard Glyph="&#xE70F;"
                                          Header="{DynamicResource Instance.Info.Launch.EditMode.Title}"
                                          Description="{DynamicResource Instance.Info.Launch.EditMode.Desc}">
                <ToggleSwitch Name="InstanceEdit"
                              IsCheckedChanged="BoolTypeConfig_OnChanged" />
            </onePointControls:SettingCard>

            <onePointControls:SettingCard Glyph="&#xE822;"
                                          Header="{DynamicResource Instance.Info.Launch.Mods.Title}"
                                          Description="{DynamicResource Instance.Info.Launch.Mods.Desc}">
                <ToggleSwitch Name="InstanceMod"
                              IsCheckedChanged="BoolTypeConfig_OnChanged" />
            </onePointControls:SettingCard>

            <onePointControls:SettingCard Glyph="&#xE7EF;"
                                          Name="IsRunAdminCard"
                                          Header="{DynamicResource Instance.Info.Launch.RunAsAdmin.Title}"
                                          Description="{DynamicResource Instance.Info.Launch.RunAsAdmin.Desc}">
                <ToggleSwitch IsChecked="False"
                              Name="IsRunAdmin"
                              IsCheckedChanged="BoolTypeConfig_OnChanged" />
            </onePointControls:SettingCard>

            <TextBlock FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Instance.Info.Group.Log}" />

            <onePointControls:SettingExpander Glyph="&#xE756;"
                                              Header="{DynamicResource Settings.Universal.Debug.Console.Title}"
                                              Description="{DynamicResource Instance.Info.Launch.Console.Desc}">
                <onePointControls:SettingExpander.RightContent>
                    <ToggleSwitch Name="InstanceConsole"
                                  IsCheckedChanged="BoolTypeConfig_OnChanged" />
                </onePointControls:SettingExpander.RightContent>
                <StackPanel>
                    <onePointControls:SettingCard Glyph=""
                                                  Header="{DynamicResource Instance.Info.Launch.DetailedLogs.Title}"
                                                  Description="{DynamicResource Instance.Info.Launch.DetailedLogs.Desc}">
                        <ToggleSwitch Name="InstanceDetailedLogs"
                                      IsCheckedChanged="BoolTypeConfig_OnChanged" />
                    </onePointControls:SettingCard>
                </StackPanel>
            </onePointControls:SettingExpander>

            <TextBlock FontWeight="Bold"
                       Name="HighLevel"
                       FontSize="14"
                       Text="{DynamicResource Instance.Info.Group.Data}" />

            <StackPanel>
                <TextBlock Text="{DynamicResource Instance.Info.Isolation.UwpNotSupported}"
                           Opacity="0.6" />

                <DockPanel>

                    <TextBlock Text="{DynamicResource Instance.Info.Isolation.SeeDetails}"
                               Opacity="0.6" />

                    <HyperlinkButton NavigateUri="https://github.com/Round-Studio/BedrockBoot/issues/74"
                                     Content="https://github.com/Round-Studio/BedrockBoot/issues/74" />
                </DockPanel>
            </StackPanel>

            <onePointControls:SettingCard Glyph="&#xECAF;"
                                          Header="{DynamicResource Instance.Info.SyncConfig.Title}"
                                          Description="{DynamicResource Instance.Info.SyncConfig.Desc}">
                <ToggleSwitch IsChecked="True"
                              Name="GameConfigSwitch"
                              IsCheckedChanged="BoolTypeConfig_OnChanged" />
            </onePointControls:SettingCard>

            <StackPanel Spacing="8"
                        Name="InstanceIsolationPanel">
                <onePointControls:SettingCard Glyph="&#xE7B8;"
                                              Name="IsolationCard"
                                              Header="{DynamicResource Settings.Game.Isolation.Title}"
                                              Description="{DynamicResource Instance.Info.Isolation.Desc}">
                    <ToggleSwitch IsChecked="True"
                                  Name="InstanceIsolated"
                                  IsCheckedChanged="BoolTypeConfig_OnChanged" />
                </onePointControls:SettingCard>

                <onePointControls:SettingCard Header="{DynamicResource Instance.Info.Isolation.Catalog.Title}"
                                              Description="{DynamicResource Instance.Info.Isolation.Catalog.Desc}"
                                              Glyph="&#xEC25;">
                    <ComboBox Width="200"
                              Name="CatalogStrategy"
                              SelectionChanged="CatalogStrategy_OnSelectionChanged"
                              SelectedIndex="2">
                        <ComboBoxItem Content="{DynamicResource Instance.Info.Isolation.Catalog.FollowGlobal}" />
                        <ComboBoxItem Content="{DynamicResource Instance.Info.Isolation.Catalog.Isolated}" />
                        <ComboBoxItem Content="{DynamicResource Instance.Info.Isolation.Catalog.Shared}" />
                    </ComboBox>
                </onePointControls:SettingCard>
            </StackPanel>

            <TextBlock FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Settings.Download.Group.Advanced}" />

            <onePointControls:SettingExpander Header="{DynamicResource Instance.Info.HttpPatch.Title}"
                                              Description="{DynamicResource Instance.Info.HttpPatch.Desc}"
                                              Glyph="&#xE839;">
                <onePointControls:SettingExpander.RightContent>
                    <ToggleSwitch Name="HttpPatchEnable"
                                  IsCheckedChanged="BoolTypeConfig_OnChanged" />
                </onePointControls:SettingExpander.RightContent>
                <StackPanel>
                    <onePointControls:SettingCard Header="{DynamicResource Instance.Info.HttpPatch.BlockServers.Title}"
                                                  Description="{DynamicResource Instance.Info.HttpPatch.BlockServers.Desc}"
                                                  Glyph="">
                        <ToggleSwitch Name="PatchServerDiscoveryBlock"
                                      IsCheckedChanged="BoolTypeConfig_OnChanged" />
                    </onePointControls:SettingCard>
                </StackPanel>
            </onePointControls:SettingExpander>

            <TextBlock FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Instance.Info.Group.Visual}" />
            
            <onePointControls:SettingExpander Header="{DynamicResource Instance.Info.MotionBlur.Title}"
                                              Description="{DynamicResource Instance.Info.MotionBlur.Desc}"
                                              Glyph="&#xEB44;">
                <onePointControls:SettingExpander.RightContent>
                    <ToggleSwitch Name="PatchVisualBlur"
                                  HorizontalAlignment="Right"
                                  IsCheckedChanged="BoolTypeConfig_OnChanged" />
                </onePointControls:SettingExpander.RightContent>
                <StackPanel>
                    <onePointControls:SettingCard Header="{DynamicResource Instance.Info.MotionBlur.Value.Title}"
                                                  Description="{DynamicResource Instance.Info.MotionBlur.Value.Desc}"
                                                  Glyph="">
                        <Slider Width="200"
                                Name="MotionValue"
                                Maximum="95"
                                ValueChanged="MotionValue_OnValueChanged"
                                Classes="Number"></Slider>
                    </onePointControls:SettingCard>
                </StackPanel>
            </onePointControls:SettingExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>