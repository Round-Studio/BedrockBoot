<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.MultiplayerPage.MultiplayerDependenceDownload">
    <StackPanel Spacing="8"
                Margin="0,0,20,0">
        <TextBlock FontWeight="Bold"
                   FontSize="14"
                   Text="{DynamicResource Multiplayer.Dep.Notice}" />
        <onePointControls:SettingCard Header="{DynamicResource Multiplayer.Dep.StartDownload.Title}"
                                      Description="{DynamicResource Multiplayer.Dep.StartDownload.Desc}"
                                      Glyph="&#xE896;"
                                      IsClickable="True"
                                      Name="DownloadBtn"
                                      Click="DownloadBtn_OnClick" />
    </StackPanel>
</UserControl>