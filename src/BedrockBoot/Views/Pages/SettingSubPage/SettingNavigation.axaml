<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.SettingSubPage.SettingNavigation">
    <ScrollViewer>
        <Grid ColumnDefinitions="7*,3*">
            <StackPanel Grid.Column="0" 
                        Margin="15,15,8,15"
                        Spacing="8">
                <onePointControls:SettingCard Margin="5, 0"
                                              Header="个性化"
                                              Description="启动器的个性化设置"
                                              Name="SetPersonalization"
                                              Click="SetPersonalization_OnClick"
                                              IsClickable="True"
                                              Glyph="&#xEE56;" />

                <onePointControls:SettingCard Margin="5, 0"
                                              Header="下载"
                                              Description="BedrockBoot 的下载行为"
                                              Name="SetDownload"
                                              Click="SetDownload_OnClick"
                                              IsClickable="True"
                                              Glyph="&#xE896;" />

                <onePointControls:SettingCard Margin="5, 0"
                                              Header="游戏"
                                              Description="操作游戏的基本设置"
                                              Name="SetGame"
                                              Click="SetGame_OnClick"
                                              IsClickable="True"
                                              Glyph="&#xE7FC;" />

                <onePointControls:SettingCard Margin="5, 0"
                                              Header="通用"
                                              Description="启动器本体通用设置"
                                              Name="Universal"
                                              Click="Universal_OnClick"
                                              IsClickable="True"
                                              Glyph="&#xE71D;" />

                <onePointControls:SettingCard Margin="5, 0"
                                              Header="关于"
                                              Description="关于 BedrockBoot"
                                              Name="AboutUs"
                                              Click="AboutUs_OnClick"
                                              IsClickable="True"
                                              Glyph="&#xE946;" />
            </StackPanel>
            
            <StackPanel Grid.Column="1"
                        Spacing="4"
                        Margin="0,15,15,15">
                <TextBlock FontWeight="Bold"
                           FontSize="14">
                    下载
                </TextBlock>
                
                <TextBlock Opacity="0.6"
                           TextWrapping="WrapWithOverflow"
                           Text="设置做符合您网络环境的下载配置，使启动器联网体验更加流畅。"></TextBlock>
                
                <TextBlock Opacity="0.6"
                           TextWrapping="WrapWithOverflow"
                           Text="部分网络环境下，MCAPPX 源将无法使用，需要使用默认的 BMCBL ② 源。"></TextBlock>
                
                <TextBlock Opacity="0.6"
                           TextWrapping="WrapWithOverflow"
                           Text="在下载线程中，我们推荐使用默认 4 线程下载，如果下载线程过多，下载速度可能会减慢。"></TextBlock>
                
                
                <TextBlock FontWeight="Bold"
                           FontSize="14">
                    游戏
                </TextBlock>
                
                <TextBlock Opacity="0.6"
                           TextWrapping="WrapWithOverflow"
                           Text="请注意游戏目录中是否含有中文以及符号等字符，如果出现以上字符，游戏很有可能无法启动。"></TextBlock>
                
                <TextBlock Opacity="0.6"
                           TextWrapping="WrapWithOverflow"
                           Text="在版本隔离中，我们推荐使用 混合模式 进行游戏，假如使用 单一模式，可能会导致其他第三方基岩版启动器无法正常安装和启动游戏。"></TextBlock>
                
                <HyperlinkButton Content="启动器常见问题"
                                 NavigateUri="https://docs.roundstudio.top/docs/product/bb/commonQuestion"></HyperlinkButton>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>