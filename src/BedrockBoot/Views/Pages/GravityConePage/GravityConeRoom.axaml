<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.GravityConePage.GravityConeRoom">
    <ScrollViewer>
        <StackPanel Spacing="8"
                    Margin="0,0,20,0">
            <TextBlock FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Multiplayer.Lobby.Title}" />
        
            <items:BorderCard Name="RoomCodeCard"
                              Padding="0,24">
                <StackPanel Spacing="0">
                    <onePointControls:FontIcon Glyph="&#xE8C8;"
                                               Margin="8,4,8,12"
                                               HorizontalAlignment="Center"
                                               FontSize="36"></onePointControls:FontIcon>
                    <TextBlock Text="{DynamicResource Multiplayer.Lobby.RoomCodeClickCopy}"
                               HorizontalAlignment="Center"
                               Opacity="0.6"></TextBlock>
                    <Button Content="RoomCode"
                            Name="RoomCodeBtn"
                            Classes="NoBorder"
                            Click="RoomCodeBtn_OnClick"
                            Padding="8,2"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            FontSize="28"></Button>
                </StackPanel>
            </items:BorderCard>

            <onePointControls:SettingCard Header="{DynamicResource Multiplayer.Lobby.ExitRoom.Title}"
                                          Description="{DynamicResource Multiplayer.Lobby.ExitRoom.Desc}"
                                          IsClickable="True"
                                          Click="CloseBtn_OnClick"
                                          Name="CloseBtn"
                                          Glyph="&#xE711;" />
        
            <StackPanel Spacing="8"
                        Name="PlayersBox">
                <TextBlock FontWeight="Bold"
                           FontSize="14"
                           Text="{DynamicResource Multiplayer.Lobby.JoinedPlayers}" />
                <StackPanel Spacing="8"
                            Name="PlayersList">
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
