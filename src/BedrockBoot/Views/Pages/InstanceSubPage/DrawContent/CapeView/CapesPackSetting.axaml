<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:navigation="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="1200"
             x:Class="BedrockBoot.Views.Pages.InstanceSubPage.DrawContent.CapeView.CapesPackSetting">
    <Grid Margin="0,0,0,10" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Margin="20,0" Spacing="8" Orientation="Horizontal">
            <Button Classes="NoBorder" Name="BackBtn" Click="BackBtn_OnClick" Padding="8" Height="32">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <onePointControls:FontIcon VerticalAlignment="Center" Glyph="&#xE76B;" />
                    <TextBlock Text="返回披风管理" />
                </StackPanel>
            </Button>
            <TextBlock Text="披风包设置" VerticalAlignment="Center" FontSize="16" />
            <TextBlock Name="PackNameLabel" Opacity="0.5" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="0" Margin="20,0" Spacing="8" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <ListBox Classes="Segmented"
                     SelectionChanged="NavBar_OnSelectionChanged"
                     Name="NavBar">
                <ListBoxItem Classes="Segmented"
                             Tag="Capes"
                             IsSelected="True">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <onePointControls:FontIcon Glyph="&#xE7B8;"
                                                   VerticalAlignment="Center" />
                        <TextBlock Text="披风文件"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Classes="Segmented"
                             Tag="Setting">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <onePointControls:FontIcon Glyph="&#xE713;"
                                                   VerticalAlignment="Center" />
                        <TextBlock Text="包设置"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </StackPanel>

        <navigation:NavigationFrame Grid.Row="1"
                                    Name="NavigationFrame" />
    </Grid>
</UserControl>