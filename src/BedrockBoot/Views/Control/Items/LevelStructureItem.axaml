<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800"
             x:Class="BedrockBoot.Views.Control.Items.LevelStructureItem">
    <onePointControls:SettingExpander Glyph="&#xF158;">
        <onePointControls:SettingExpander.Header>
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="StructureName"
                           Text="-"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </onePointControls:SettingExpander.Header>
        <onePointControls:SettingExpander.Description>
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="StructureInfo"
                           Text="-"
                           TextTrimming="CharacterEllipsis" />
                
                <TextBlock Name="StructurePath"
                           Text="-"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </onePointControls:SettingExpander.Description>
        
        <StackPanel>
            <onePointControls:SettingCard Name="ExportBtn"
                                          Glyph="&#xE74E;"
                                          IsClickable="True"
                                          Header="导出结构"
                                          Click="ExportBtn_OnClick">
            </onePointControls:SettingCard>
            <onePointControls:SettingCard Name="DeleteBtn"
                                          IsClickable="True"
                                          Click="DeleteBtn_OnClick" 
                                          Glyph="&#xE74D;"
                                          Header="删除结构">
            </onePointControls:SettingCard>
        </StackPanel>
    </onePointControls:SettingExpander>
</UserControl>
