<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.SettingSubPage.SettingUniversalPages.UniversalDependencyUpdate">
    <ScrollViewer>
        <!-- 边距与同级页面 (UniversalDebug / UniversalSoftwareUpdate) 保持一致：
             面板 Margin="20,15"，卡片与标题不再叠加额外边距 -->
        <StackPanel Margin="20,15"
                    Spacing="8">
            <TextBlock FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Settings.Universal.Dependency.Group.Dependencies}" />

            <onePointControls:SettingCard Name="EasyTierCard"
                                          Header="EasyTier"
                                          Description="{DynamicResource Settings.Universal.Dependency.ReadingVersion}"
                                          IsShowActionIcon="False"
                                          Glyph="&#xE968;">
                <TextBlock Name="EasyTierLatestText"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           Text="" />
            </onePointControls:SettingCard>

            <onePointControls:SettingCard Name="GravityConeCard"
                                          Header="GravityCone"
                                          Description="{DynamicResource Settings.Universal.Dependency.ReadingVersion}"
                                          IsShowActionIcon="False"
                                          Glyph="&#xE774;">
                <TextBlock Name="GravityConeLatestText"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           Text="" />
            </onePointControls:SettingCard>

            <TextBlock FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Settings.Universal.Group.Behavior}" />

            <onePointControls:SettingCard Name="CheckCard"
                                          Header="{DynamicResource Settings.Universal.Dependency.Check.Title}"
                                          Description="{DynamicResource Settings.Universal.Dependency.Check.Desc}"
                                          IsShowActionIcon="False"
                                          Glyph="&#xE895;">
                <Button Padding="8"
                        Height="36"
                        MinWidth="100"
                        Name="CheckUpdateBtn"
                        Content="{DynamicResource Settings.Universal.Dependency.Check.Action}"
                        Click="CheckUpdateBtn_OnClick" />
            </onePointControls:SettingCard>

            <onePointControls:SettingCard Name="UpdateCard"
                                          IsVisible="False"
                                          Header="{DynamicResource Settings.Universal.Dependency.Update.Title}"
                                          Description="{DynamicResource Settings.Universal.Dependency.Update.Desc}"
                                          IsShowActionIcon="False"
                                          Glyph="&#xE896;">
                <Button Padding="8"
                        Height="36"
                        MinWidth="100"
                        Name="UpdateBtn"
                        Content="{DynamicResource Settings.Universal.Dependency.Update.Action}"
                        Click="UpdateBtn_OnClick" />
            </onePointControls:SettingCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
