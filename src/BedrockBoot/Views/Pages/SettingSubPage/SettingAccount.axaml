<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.SettingSubPage.SettingAccount">
    <ScrollViewer>
        <StackPanel Margin="20,15"
                    Spacing="8">
            <TextBlock FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Settings.Account.Group.Xbox}" />

            <onePointControls:SettingCard Header="{DynamicResource Account.Action.LinkXbox}"
                                          Description="{DynamicResource Settings.Account.Xbox.Link.Desc}"
                                          Name="AddAccountBtn"
                                          Click="AddAccountBtn_OnClick"
                                          IsClickable="True"
                                          Glyph="&#xE8FA;" />

            <Grid>
                <StackPanel Name="AccountPanel"
                            Spacing="8" />
                
                <notice:InfoCard HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Name="NullCard"
                                 Margin="0,60"
Message="{DynamicResource Account.Empty.Message}"
                                  BigTitle="{DynamicResource Account.Empty.Title}"/>
            </Grid>
            
            <TextBlock FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Settings.Account.Group.GitHub}" />

            <onePointControls:SettingExpander Name="GithubExpander"
                                              Glyph="&#xE77B;"
                                              Description="{DynamicResource Settings.Account.GitHub.Description}">
                <onePointControls:SettingExpander.Header>
                    <TextBlock Name="GithubHeaderText"
                               Text="{DynamicResource Settings.Account.Group.GitHub}" />
                </onePointControls:SettingExpander.Header>
                <StackPanel>
                    <onePointControls:SettingCard Header="{DynamicResource Settings.Account.GitHub.Login.Title}"
                                                  Description="{DynamicResource Settings.Account.GitHub.Login.Desc}"
                                                  Name="LoginInGithub"
                                                  Click="LoginInGithub_OnClick"
                                                  IsClickable="True"
                                                  Glyph="&#xE8FA;" />
                    <onePointControls:SettingCard Header="{DynamicResource Settings.Account.GitHub.Logout.Title}"
                                                  Description="{DynamicResource Settings.Account.GitHub.Logout.Desc}"
                                                  Name="GithubLogoutBtn"
                                                  Click="GithubLogoutBtn_OnClick"
                                                  IsClickable="True"
                                                  IsVisible="False"
                                                  Glyph="&#xE74D;" />
                </StackPanel>
            </onePointControls:SettingExpander>
            
            <TextBlock FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Settings.Account.Group.Advanced}" />

            <onePointControls:SettingCard Name="IsAskMeBeforeLaunchCard"
                                          Header="{DynamicResource Account.Option.AskBeforeLaunch.Title}"
                                          Description="{DynamicResource Account.Option.AskBeforeLaunch.Desc}"
                                          Glyph="&#xE8B0;">
                <ToggleSwitch Name="IsAskMeBeforeLaunch"
                              IsCheckedChanged="IsAskMeBeforeLaunch_OnIsCheckedChanged">
                </ToggleSwitch>
            </onePointControls:SettingCard>

            <onePointControls:SettingCard Name="IsUseMultipleUsersCard"
                                          Header="{DynamicResource Settings.Game.MultipleUsers.Title}"
                                          Description="{DynamicResource Settings.Game.MultipleUsers.Desc}"
                                          Glyph="&#xE716;">
                <ToggleSwitch Name="IsUseMultipleUsers"
                              IsCheckedChanged="IsUseMultipleUsers_OnIsCheckedChanged">
                </ToggleSwitch>
            </onePointControls:SettingCard>

            <onePointControls:SettingCard Name="IsUseMSALAccountCard"
                                          Header="{DynamicResource Settings.Account.MSAL.Title}"
                                          Description="{DynamicResource Settings.Account.MSAL.Desc}"
                                          Glyph="&#xF32A;">
                <ToggleSwitch Name="IsUseMSALAccount"
                              IsCheckedChanged="IsUseMSALAccount_OnIsCheckedChanged">
                </ToggleSwitch>
            </onePointControls:SettingCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>