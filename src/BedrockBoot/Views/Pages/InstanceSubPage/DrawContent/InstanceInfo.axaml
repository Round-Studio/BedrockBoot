<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.InstanceSubPage.DrawContent.InstanceInfo">
    <Grid>
        <ScrollViewer>
            <StackPanel Margin="20,0,20,0"
                        Spacing="8">
                <items:BorderCard>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <Border CornerRadius="6"
                                    Margin="0,0,0,0"
                                    Name="IconBox"
                                    Width="80"
                                    Height="80">
                                <Border.Background>
                                    <ImageBrush Source="avares://Round.SDK.Avalonia/Image/Icon/mc_grassblock_neo.png" />
                                </Border.Background>
                            </Border>

                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="20"
                                       Margin="0,20,0,2"
                                       Name="VersionName"
                                       FontWeight="Bold">
                                Version Name
                            </TextBlock>

                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="11"
                                       Opacity="0.6"
                                       Name="VersionReady">
                                Version Ready Version
                            </TextBlock>

                            <StackPanel HorizontalAlignment="Center"
                                        Margin="0,12,0,0"
                                        Spacing="8"
                                        Opacity="0.6">
                                <StackPanel Spacing="4"
                                            Orientation="Horizontal">
                                    <onePointControls:FontIcon FontSize="16"
                                                               Glyph="&#xE916;" />
                                    <TextBlock Text="TotalDuration"
                                               Name="TotalDuration" />
                                </StackPanel>
                            </StackPanel>

                            <Button Padding="16,8"
                                    HorizontalAlignment="Stretch"
                                    Margin="30,12,30,5"
                                    MaxWidth="160"
                                    Classes="NoBorder"
                                    Background="{DynamicResource AccentBackgroundBrush}"
                                    Name="LaunchBtn"
                                    Click="LaunchBtn_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <onePointControls:FontIcon Glyph="&#xE768;"
                                                               VerticalAlignment="Center"
                                                               FontSize="14"
                                                               Margin="0,0,20,0" />
                                    <TextBlock Text="{DynamicResource Shared.Action.Launch}"
                                               FontSize="15"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="5"
                                        HorizontalAlignment="Center"
                                        Margin="5">
                                <Button Width="24" Height="24"
                                        Name="OpenFolderBtn"
                                        Click="OpenFolderBtn_OnClick"
                                        Classes="NoBorder">
                                    <onePointControls:FontIcon Glyph="&#xE8B7;" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </items:BorderCard>
                
                <TextBlock FontWeight="Bold"
                           FontSize="14"
                           Text="{DynamicResource Settings.Game.Group.Base}" />

                <onePointControls:SettingCard Glyph="&#xE8AC;"
                                              Header="{DynamicResource Instance.Info.Name.Title}"
                                              Description="{DynamicResource Instance.Info.Name.Desc}">
                    <TextBox Width="200"
                             Name="InstanceName"
                             TextChanged="TextTypeConfig_OnChanged" />
                </onePointControls:SettingCard>

                <onePointControls:SettingCard Glyph="&#xEB9F;"
                                              IsEnabled="False"
                                              IsVisible="False"
                                              Header="{DynamicResource Instance.Info.Icon.Title}"
                                              Description="{DynamicResource Instance.Info.Icon.Desc}">
                    <ComboBox Width="200"
                              SelectedIndex="0">
                        <ComboBoxItem Content="{DynamicResource Instance.Info.Icon.Grass}" />
                        <ComboBoxItem Content="{DynamicResource Instance.Info.Icon.Path}" />
                        <ComboBoxItem Content="{DynamicResource Instance.Info.Icon.EndStone}" />
                        <ComboBoxItem Content="{DynamicResource Instance.Info.Icon.Crafting}" />
                    </ComboBox>
                </onePointControls:SettingCard>

                <TextBlock FontWeight="Bold"
                           FontSize="14"
                           Text="{DynamicResource Instance.Info.Group.Launch}" />

                <onePointControls:SettingExpander Header="{DynamicResource Instance.Info.Launch.Title}"
                                                  Description="{DynamicResource Instance.Info.Launch.Desc}"
                                                  Glyph="&#xECAD;">
                    <StackPanel>
                        <onePointControls:SettingCard Glyph="&#xEC06;"
                                                      Header="{DynamicResource Instance.Info.Launch.Args.Title}"
                                                      Description="{DynamicResource Instance.Info.Launch.Args.Desc}"
                                                      Classes="Item">
                            <TextBox Width="200"
                                     Name="InstanceArgs"
                                     TextChanged="TextTypeConfig_OnChanged" />
                        </onePointControls:SettingCard>

                        <onePointControls:SettingCard Glyph="&#xE70F;"
                                                      Header="{DynamicResource Instance.Info.Launch.EditMode.Title}"
                                                      Description="{DynamicResource Instance.Info.Launch.EditMode.Desc}"
                                                      Classes="Item">
                            <ToggleSwitch Name="InstanceEdit"
                                          IsCheckedChanged="BoolTypeConfig_OnChanged" />
                        </onePointControls:SettingCard>

                        <onePointControls:SettingCard Glyph="&#xE822;"
                                                      Header="{DynamicResource Instance.Info.Launch.Mods.Title}"
                                                      Description="{DynamicResource Instance.Info.Launch.Mods.Desc}"
                                                      Classes="Item">
                            <ToggleSwitch Name="InstanceMod"
                                          IsCheckedChanged="BoolTypeConfig_OnChanged" />
                        </onePointControls:SettingCard>

                        <onePointControls:SettingCard Glyph="&#xE756;"
                                                      Header="{DynamicResource Settings.Universal.Debug.Console.Title}"
                                                      Description="{DynamicResource Instance.Info.Launch.Console.Desc}"
                                                      Classes="Item">
                            <ToggleSwitch Name="InstanceConsole"
                                          IsCheckedChanged="BoolTypeConfig_OnChanged" />
                        </onePointControls:SettingCard>

                        <onePointControls:SettingCard Glyph="&#xE8A1;"
                                                      Header="详细日志"
                                                      Description="输出详细的日志，包括游戏底层的文件操作（开启后会有卡顿）"
                                                      Classes="Item">
                            <ToggleSwitch Name="InstanceDetailedLogs"
                                          IsCheckedChanged="BoolTypeConfig_OnChanged" />
                        </onePointControls:SettingCard>
                    </StackPanel>
                </onePointControls:SettingExpander>

                <TextBlock FontWeight="Bold"
                           Name="HighLevel"
                           FontSize="14"
                           Text="{DynamicResource Settings.Download.Group.Advanced}" />

                <onePointControls:SettingCard Glyph="&#xE7B8;"
                                              Name="IsolationCard"
                                              Header="{DynamicResource Settings.Game.Isolation.Title}"
                                              Description="{DynamicResource Instance.Info.Isolation.Desc}">
                    <ToggleSwitch IsChecked="True"
                                  Name="InstanceIsolated"
                                  IsCheckedChanged="BoolTypeConfig_OnChanged" />
                </onePointControls:SettingCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>