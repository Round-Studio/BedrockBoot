<entry:BedrockBootPage xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:entry="clr-namespace:BedrockBoot.Standard.Entity;assembly=BedrockBoot.Standard"
                 xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
                 xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
                 xmlns:view="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.View;assembly=OnePointUI.Avalonia"
                 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                 x:Class="BedrockBoot.Views.Pages.MainSubPage.MainAccountPage">
    <entry:BedrockBootPage.HeaderView>
        <Grid Width="400"
              HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="8">
                <onePointControls:LineTextBlock VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                FontSize="28"
                                                Margin="0"
                                                FontWeight="Bold"
                                                Text="{DynamicResource MainPage.Nav.AccountManager}" />

                <Button Padding="12,8"
                        Height="32"
                        Name="LoginBtn"
                        Click="LoginBtn_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <onePointControls:FontIcon Glyph="&#xE8fa;"
                                                   VerticalAlignment="Center" />
                        <TextBlock Margin="4,0,0,0"
                                   Text="{DynamicResource Account.Action.LinkXbox}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </entry:BedrockBootPage.HeaderView>
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0">
            <view:ItemView Name="UsersList" 
                           SelectionChanged="UsersList_OnSelectionChanged"
                           Margin="10"/>
        </ScrollViewer>
        
        <notice:InfoCard Grid.Row="0"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Name="NoneCard"
                         BigTitle="{DynamicResource Account.Empty.Title}"
                         Message="{DynamicResource Account.Empty.Message}" />
        
        <StackPanel Grid.Row="1"
                    Margin="20,0,0,10"
                    Orientation="Horizontal"
                    Spacing="8">
            <ToggleSwitch Name="IsChooseAccountBeforeLaunch"
                          IsCheckedChanged="IsChooseAccountBeforeLaunch_OnIsCheckedChanged"></ToggleSwitch>
            <TextBlock Text="{DynamicResource Account.Option.AskBeforeLaunch}"
                       VerticalAlignment="Center"></TextBlock>
        </StackPanel>
    </Grid>
</entry:BedrockBootPage>
