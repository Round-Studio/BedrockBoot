<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:global="clr-namespace:BedrockBoot.Models.Global"
             xmlns:interopServices="clr-namespace:System.Runtime.InteropServices;assembly=System.Runtime"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.OtherPage.AboutPages.AboutPage">
    <ScrollViewer>
        <StackPanel Margin="20,15"
                    Spacing="8">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <Image Source="avares://BedrockBoot/Assets/Icon/BedrockBoot.Icon.256x.png"
                           Width="64"
                           Height="64"
                           HorizontalAlignment="Left" />

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <onePointControls:LineTextBlock Text="BedrockBoot"
                                                            Margin="12,0,0,0" />
                        </StackPanel>

                        <StackPanel Margin="12,0,0,0" 
                                    Spacing="8"
                                    Orientation="Horizontal"
                                    Opacity="0.8">
                            <TextBlock Text="{x:Static global:GlobalModel.BodyVersion}"></TextBlock>
                            
                            <TextBlock Name="PowerByTextBlock"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
            
            <onePointControls:SettingExpander Header="{DynamicResource About.Page.EnvironmentInfo}"
                                              Description="{DynamicResource About.Page.EnvironmentInfo.Desc}"
                                              IsExpanded="True"
                                              Glyph="&#xE946;">
                <StackPanel>
                    <onePointControls:SettingCard Header="{DynamicResource About.Page.BodyVersion}"
                                                  Content="{x:Static global:GlobalModel.BodyVersion}"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="{DynamicResource About.Page.RuntimeEnv}"
                                                  Content="{x:Static interopServices:RuntimeInformation.OSDescription}"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="{DynamicResource About.Page.Runtime}"
                                                  Content="{x:Static interopServices:RuntimeInformation.FrameworkDescription}"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="{DynamicResource About.Page.WorkDir}"
                                                  Content="{x:Static sys:Environment.CurrentDirectory}"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="{DynamicResource About.Page.DeviceName}"
                                                  Content="{x:Static sys:Environment.MachineName}"
                                                  Glyph=""></onePointControls:SettingCard>
                </StackPanel>
            </onePointControls:SettingExpander>
            
            <onePointControls:SettingExpander Header="{DynamicResource About.Section.Credits}"
                                              Description="{DynamicResource About.Page.Credits.Desc}"
                                              Glyph="&#xE7C1;">
                <StackPanel>
                    <onePointControls:SettingCard Header="McAppx.com"
                                                  Description="{DynamicResource About.Credits.MCAPPX}"
                                                  IsClickable="True"
                                                  Tag="https://www.mcappx.com/"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="github.akams.cn"
                                                  Description="{DynamicResource About.Credits.Akams}"
                                                  IsClickable="True"
                                                  Tag="https://github.akams.cn/"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="CurseForge"
                                                  Description="{DynamicResource About.Credits.CurseForge}"
                                                  IsClickable="True"
                                                  Tag="https://curseforge.com/"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="BMCBL"
                                                  Description="{DynamicResource About.Credits.BMCBL}"
                                                  IsClickable="True"
                                                  Tag="https://bmcbl.chlna6666.com/"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                </StackPanel>
            </onePointControls:SettingExpander>
            
            <onePointControls:SettingExpander Header="{DynamicResource About.Section.Inspiration}"
                                              Description="{DynamicResource About.Page.Inspiration.Desc}"
                                              Glyph="&#xE734;">
                <StackPanel>
                    <onePointControls:SettingCard Header="BakaXL"
                                                  Description="{DynamicResource About.Page.BakaXL.Desc}"
                                                  IsClickable="True"
                                                  Tag="https://bakaxl.com/"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="BMCBL"
                                                  Description="{DynamicResource About.Page.BMCBL.Desc}"
                                                  IsClickable="True"
                                                  Tag="https://bmcbl.chlna6666.com/"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="LauncherX"
                                                  Description="{DynamicResource About.Inspiration.LauncherX}"
                                                  IsClickable="True"
                                                  Tag="https://corona.studio/lx"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="WonderLab"
                                                  Description="{DynamicResource About.Inspiration.WonderLab}"
                                                  IsClickable="True"
                                                  Tag="https://github.com/Lunova-Studio/WonderLab.Override"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="Polymerium"
                                                  Description="{DynamicResource About.Inspiration.Polymerium}"
                                                  IsClickable="True"
                                                  Tag="https://github.com/d3ara1n/Polymerium"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                </StackPanel>
            </onePointControls:SettingExpander>
            
            <onePointControls:SettingExpander Header="{DynamicResource About.Section.Developers}"
                                              Description="{DynamicResource About.Page.Developers.Desc}"
                                              Glyph="&#xEC7A;">
                <StackPanel>
                    <onePointControls:SettingCard Header="Dime12022"
                                                  ImageIcon="avares://BedrockBoot/Assets/Image/Contributors/Dime12022_ImageIcon.jpg"
                                                  IsFontIcon="False"
                                                  Classes="People"
                                                  Description="{DynamicResource About.Page.CoreDev}"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="YoumiHa"
                                                  ImageIcon="avares://BedrockBoot/Assets/Image/Contributors/YoumiHa_ImageIcon.jpg"
                                                  IsFontIcon="False"
                                                  Classes="People"
                                                  Description="{DynamicResource About.Page.CoreDev}"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="DrMing (蛆)"
                                                  ImageIcon="avares://BedrockBoot/Assets/Image/Contributors/DrMing_ImageIcon.jpg"
                                                  IsFontIcon="False"
                                                  Classes="People"
                                                  Description="{DynamicResource About.Page.UIDev}"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="Chlna6666 (BMCBL)"
                                                  ImageIcon="avares://BedrockBoot/Assets/Image/Contributors/Chlna6666_ImageIcon.jpg"
                                                  IsFontIcon="False"
                                                  Classes="People"
                                                  Description="{DynamicResource About.Page.ProtocolDev}"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="Tianpao (天跑)"
                                                  ImageIcon="avares://BedrockBoot/Assets/Image/Contributors/Tianpao_ImageIcon.jpg"
                                                  IsFontIcon="False"
                                                  Classes="People"
                                                  Description="{DynamicResource About.Page.NetworkDev}"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="{DynamicResource About.Page.AllContributors}"
                                                  Description="{DynamicResource About.Page.AllContributors.Desc}"
                                                  IsClickable="True"
                                                  Name="ContributorsBtn"
                                                  Click="ContributorsBtn_OnClick"
                                                  Glyph=""></onePointControls:SettingCard>
                </StackPanel>
            </onePointControls:SettingExpander>
            
            <onePointControls:SettingExpander Header="{DynamicResource About.Page.Links}"
                                              Description="{DynamicResource About.Page.Links.Desc}"
                                              Glyph="&#xE8A7;">
                <StackPanel>
                    <onePointControls:SettingCard Header="{DynamicResource About.Page.GitHub}"
                                                  Description="https://github.com/Round-Studio/BedrockBoot"
                                                  IsClickable="True"
                                                  Tag="https://github.com/Round-Studio/BedrockBoot"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="{DynamicResource About.Page.Issues}"
                                                  Description="https://github.com/Round-Studio/BedrockBoot/issues"
                                                  IsClickable="True"
                                                  Tag="https://github.com/Round-Studio/BedrockBoot/issues"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="{DynamicResource About.Page.Website}"
                                                  Description="https://bb.roundstudio.top"
                                                  IsClickable="True"
                                                  Tag="https://bb.roundstudio.top"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="{DynamicResource About.Page.Docs}"
                                                  Description="https://docs.roundstudio.top/docs/product/bb"
                                                  IsClickable="True"
                                                  Tag="https://docs.roundstudio.top/docs/product/bb"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="{DynamicResource About.Page.Privacy}"
                                                  Description="https://bb.roundstudio.top/privacyPolicy"
                                                  IsClickable="True"
                                                  Tag="https://bb.roundstudio.top/privacyPolicy"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                    <onePointControls:SettingCard Header="{DynamicResource About.Page.Afdian}"
                                                  Description="{DynamicResource About.Page.Afdian.Desc}"
                                                  IsClickable="True"
                                                  Tag="https://ifdian.net/a/yjq666"
                                                  Click="LinkOpener"
                                                  Glyph=""></onePointControls:SettingCard>
                </StackPanel>
            </onePointControls:SettingExpander>

            <onePointControls:SettingCard Glyph="&#xE909;"
                                          Header="{DynamicResource About.Action.OpenSourceLib.Title}"
                                          Description="{DynamicResource About.Action.OpenSourceLib.Desc}"
                                          Name="OpenSourceBtn"
                                          Click="OpenSourceBtn_OnClick"
                                          IsClickable="True" />

            <onePointControls:SettingCard Glyph="&#xF4AA;"
                                          Name="VersionCard"
                                          Click="VersionCard_OnClick"
                                          IsClickable="True" 
                                          Header="{DynamicResource About.Action.Version.Title}"
                                          Description="{x:Static global:GlobalModel.BodyVersion}">
            </onePointControls:SettingCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>