<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="BedrockBoot.Views.DialogContent.Cape.DialogAddCapeFileContent">
    <Grid ColumnDefinitions="Auto,*"
          ColumnSpacing="8">
        <StackPanel Grid.Column="0">
            <Image Width="96"
                   Height="96"
                   Name="CapePreview"></Image>
        </StackPanel>
        
        <StackPanel Grid.Column="1"
                    Spacing="8">
            <TextBlock Text="{DynamicResource Cape.Dialog.AddFile.Name}"></TextBlock>
            <TextBox Width="200"
                     Watermark="{DynamicResource Cape.Dialog.AddFile.Name}"
                     Name="CapeName"></TextBox>
            <TextBlock Text="{DynamicResource Cape.Dialog.AddFile.Quality}"></TextBlock>
            <ComboBox Width="200"
                      Name="CapeType"
                      SelectedIndex="0">
                <ComboBoxItem Content="{DynamicResource Cape.Quality.Common}" />
                <ComboBoxItem Content="{DynamicResource Cape.Quality.Uncommon}" />
                <ComboBoxItem Content="{DynamicResource Cape.Quality.Rare}" />
                <ComboBoxItem Content="{DynamicResource Cape.Quality.Epic}" />
                <ComboBoxItem Content="{DynamicResource Cape.Quality.Legendary}" />
            </ComboBox>
        </StackPanel>
    </Grid>
</UserControl>
