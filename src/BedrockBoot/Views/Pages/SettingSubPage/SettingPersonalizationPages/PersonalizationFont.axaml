<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.SettingSubPage.SettingPersonalizationPages.PersonalizationFont">
    <ScrollViewer>
        <StackPanel Margin="15">
            <TextBlock FontWeight="Bold"
                       Margin="5,0"
                       FontSize="14"
                       Text="界面字体" />
            
            <onePointControls:SettingCard Header="{DynamicResource Settings.Color.Theme.Title}"
                                          Margin="5"
                                          Description="{DynamicResource Settings.Color.Theme.Desc}"
                                          Glyph="&#xE793;">
                
            </onePointControls:SettingCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
