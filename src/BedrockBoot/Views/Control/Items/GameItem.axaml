<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400"
             x:Class="BedrockBoot.Views.Control.Items.GameItem">
    <onePointControls:SettingCard IsClickable="True"
                                  Name="Card"
                                  Glyph="&#xE7FC;"
                                  IsFontIcon="False"
                                  IsShowActionIcon="False">
        <onePointControls:SettingCard.Header>
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <TextBlock Name="VersionName"
                           Text="GameName" />

                <!-- 版本类型（正式版/测试版等）与构建类型（UWP/GDK），由代码填充 -->
                <StackPanel Orientation="Horizontal"
                            Spacing="4"
                            Name="HeaderLabelsPanel"
                            VerticalAlignment="Center"
                            IsVisible="False" />

                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            Name="ModLoadersPanel">
                </StackPanel>

                <onePointControls:LabelBox Text="{DynamicResource Manager.GameItem.EditModel}"
                                           Foreground="White"
                                           Background="Purple"
                                           Name="EditModule"
                                           IsVisible="False"
                                           VerticalAlignment="Center" />
            </StackPanel>
        </onePointControls:SettingCard.Header>

        <!-- 内部版本号与游玩时长 -->
        <onePointControls:SettingCard.Description>
            <TextBlock Name="DescriptionText"
                       Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis"
                       Text="1.21.0.0" />
        </onePointControls:SettingCard.Description>

        <StackPanel Orientation="Horizontal">
            <Button Width="32" Height="32"
                    Classes="NoBorder"
                    Name="SettingBtn"
                    Margin="0,0,8,0"
                    Click="Card_OnClick">
                <onePointControls:FontIcon Glyph="&#xE713;"
                                           FontSize="16" />
            </Button>

            <Button Padding="16,8"
                    Classes="NoBorder"
                    Background="{DynamicResource AccentBackgroundBrush}"
                    Name="LaunchBtn"
                    Click="LaunchBtn_OnClick">
                <StackPanel Orientation="Horizontal">
                    <onePointControls:FontIcon Glyph="&#xE768;"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               Margin="0,0,8,0" />

                    <TextBlock Text="{DynamicResource Manager.GameItem.Launch}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </onePointControls:SettingCard>
</UserControl>