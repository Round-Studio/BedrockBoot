<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.DevelopPage.Plugin.ProjectList">
    <Grid>
        <ScrollViewer Margin="0,0,5,0">
            <StackPanel Margin="0,0,15,0"
                        Spacing="8"
                        Name="ProjectStackPanel">
                
            </StackPanel>
        </ScrollViewer>
        
        <notice:InfoCard Message="请单击左侧创建项目以创建新插件项目"
                         BigTitle="当前没有任何项目"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Name="NoneCard"/>
    </Grid>
</UserControl>
