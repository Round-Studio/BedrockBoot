<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             xmlns:navigation="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation;assembly=OnePointUI.Avalonia"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:selectBar="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation.SelectBar;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.MainPage">
    <Grid RowDefinitions="Auto,*,Auto">
        <navigation:NavigationFrame Grid.Row="0"
                                    Name="HeaderContent"
                                    Margin="20,12,0,0"
                                    Height="48"
                                    NavigationFrameDirection="Right"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch" />

        <navigation:NavigationFrame Grid.Row="1"
                                    Name="MainFrame" />

        <items:BorderCard Grid.Row="2"
                          Height="48"
                          Padding="0"
                          CornerRadius="0"
                          HorizontalAlignment="Stretch">
            <Grid Height="48">
                <StackPanel HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Spacing="6"
                            Orientation="Horizontal"
                            Margin="6"
                            Name="GameControls">
                    <Button Padding="22,0"
                            Classes="NoBorder"
                            Background="{DynamicResource AccentBackgroundBrush}"
                            Name="GameLaunchBtn"
                            Click="GameLaunchBtn_OnClick">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <onePointControls:FontIcon VerticalAlignment="Center"
                                                       FontSize="17"
                                                       Foreground="White"
                                                       Glyph="&#xE709;" />

                            <TextBlock Text="{DynamicResource Main.Action.Launch}"
                                       Foreground="White"
                                       FontSize="15" />
                        </StackPanel>
                    </Button>

                    <Button Padding="8,0"
                            Classes="NoBorder"
                            Name="GameSettingBtn"
                            Click="GameSettingBtn_OnClick">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="GameName" Name="GameName" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4">
                                <onePointControls:LabelBox Name="GameBuildType"
                                                           FontSize="8"
                                                           Background="Chocolate"
                                                           Foreground="White" />
                                <TextBlock Text="GameInfo" Name="GameInfo"
                                           VerticalAlignment="Center"
                                           Opacity="0.6"
                                           FontSize="9" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <selectBar:SelectBar SelectedIndex="0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Stretch"
                                     Margin="0"
                                     SelectionChanged="SelTag_OnSelectionChanged"
                                     Name="SelTag" />

                <ComboBox Height="32"
                          Width="260"
                          SelectedIndex="0"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          Margin="6"
                          SelectionChanged="GameListChoose_OnSelectionChanged"
                          Name="GameListChoose">
                    <ComboBoxItem Content="{DynamicResource Main.GameList.Empty}" />
                </ComboBox>
            </Grid>
        </items:BorderCard>
    </Grid>
</UserControl>