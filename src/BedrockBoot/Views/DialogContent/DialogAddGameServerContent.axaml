<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="BedrockBoot.Views.DialogContent.DialogAddGameServerContent">
    <StackPanel>
        <TextBlock Margin="0,5,0,5"
                   HorizontalAlignment="Left"
                   Text="{DynamicResource Dialog.AddServer.Label.Name}" />
        <TextBox Margin="0,5,0,5" Width="320"
                 Watermark="{DynamicResource Dialog.AddServer.Watermark.Name}"
                 Name="ServerNameInputBox" />
        
        <TextBlock Margin="0,5,0,5"
                   HorizontalAlignment="Left"
                   Text="{DynamicResource Dialog.AddServer.Label.Address}" />
        <TextBox Margin="0,5,0,5" Width="320"
                 Watermark="play.example.com"
                 Name="ServerAddressInputBox" />
        
        <TextBlock Margin="0,5,0,5"
                   HorizontalAlignment="Left"
                   Text="{DynamicResource Dialog.AddServer.Label.Port}" />
        <TextBox Margin="0,5,0,5" Width="320"
                 Watermark="19132"
                 Name="ServerPortInputBox" />
    </StackPanel>
</UserControl>