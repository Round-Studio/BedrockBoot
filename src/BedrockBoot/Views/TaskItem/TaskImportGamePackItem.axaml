<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d"
             x:Class="BedrockBoot.Views.TaskItem.TaskImportGamePackItem">
    <items:BorderCard>
        <Grid ColumnDefinitions="Auto,*,Auto">
            <onePointControls:FontIcon Grid.Column="0"
                                       Glyph="&#xE8B5;"
                                       VerticalAlignment="Top"
                                       Margin="4,4,0,0"
                                       FontSize="28">
            </onePointControls:FontIcon>

            <StackPanel Grid.Column="1" Margin="15,0,10,0"
                        HorizontalAlignment="Stretch">
                <TextBlock FontSize="16"
                           Name="CardTitle"
                           Text="{DynamicResource Task.ImportPack.Title}" />

                <StackPanel Margin="0,8,0,0"
                            HorizontalAlignment="Stretch">
                    <ProgressBar IsIndeterminate="True"
                                 HorizontalAlignment="Stretch"
                                 Name="ProgressBar" />

                    <TextBlock Foreground="Gray"
                               FontSize="9"
                               Margin="0,2,0,0"
                               Name="ProgressText"
                               Text="{DynamicResource Task.ImportPack.Status.Preparing}" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="2"
                    Classes="NoBorder"
                    Width="32" Height="32"
                    IsVisible="False"
                    Name="CancelBtn"
                    Click="CancelButton_OnClick">
                <onePointControls:FontIcon Glyph="&#xE711;"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           FontSize="16" />
            </Button>
        </Grid>
    </items:BorderCard>
</UserControl>