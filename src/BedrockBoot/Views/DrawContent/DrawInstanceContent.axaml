<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:navigation="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation;assembly=OnePointUI.Avalonia"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="600"
             x:Class="BedrockBoot.Views.DrawContent.DrawInstanceContent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"
                              MaxWidth="300" />
            <ColumnDefinition Width="7*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <items:BorderCard Margin="20,10,5,20">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <Border CornerRadius="6"
                                Margin="0,0,0,0"
                                Name="IconBox"
                                Width="80"
                                Height="80">
                            <Border.Background>
                                <ImageBrush Source="avares://Round.SDK.Avalonia/Image/Icon/mc_grassblock_neo.png" />
                            </Border.Background>
                        </Border>

                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="20"
                                   Margin="0,20,0,2"
                                   Name="VersionName"
                                   FontWeight="Bold">
                            Version Name
                        </TextBlock>

                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Name="VersionReady">
                            Version Ready Version
                        </TextBlock>
                        
                        <StackPanel HorizontalAlignment="Center"
                                    Margin="0,12,0,0"
                                    Spacing="8"
                                    Opacity="0.6">
                            <StackPanel Spacing="4"
                                        Orientation="Horizontal">
                                <onePointControls:FontIcon FontSize="16"
                                                           Glyph="&#xE916;"></onePointControls:FontIcon>
                                <TextBlock Text="TotalDuration"
                                           Name="TotalDuration"></TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <Button Padding="16,8"
                                HorizontalAlignment="Stretch"
                                Margin="30,12,30,5"
                                MaxWidth="160"
                                Classes="NoBorder"
                                Background="{DynamicResource AccentBackgroundBrush}"
                                Name="LaunchBtn"
                                Click="LaunchBtn_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <onePointControls:FontIcon Glyph="&#xE768;"
                                                           VerticalAlignment="Center"
                                                           FontSize="14"
                                                           Margin="0,0,20,0" />
                                <TextBlock Text="{DynamicResource Shared.Action.Launch}"
                                           FontSize="15"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="5"
                                    HorizontalAlignment="Center"
                                    Margin="5">
                            <Button Width="24" Height="24"
                                    Name="OpenFolderBtn"
                                    Click="OpenFolderBtn_OnClick"
                                    Classes="NoBorder">
                                <onePointControls:FontIcon Glyph="&#xE8B7;" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </items:BorderCard>
        </Grid>

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*">
            <TabControl Grid.Row="0"
                        Name="InstanceTabControl"
                        SelectedIndex="0"
                        SelectionChanged="InstanceTabControl_OnSelectionChanged"
                        Margin="5,0,10,0">
                <TabItem Header="{DynamicResource Draw.Instance.Tab.Detail}" Tag="Info" Name="Info"/>
                <TabItem Header="{DynamicResource Draw.Instance.Tab.Mods}" Tag="Mods" Name="Mods"/>
                <TabItem Header="{DynamicResource Draw.Instance.Tab.Packs}" Tag="Pack" Name="Pack"/>
                <TabItem Header="{DynamicResource Draw.Instance.Tab.Archive}" Tag="Save" Name="Save"/>
                <TabItem Header="{DynamicResource Draw.Instance.Tab.Screenshots}" Tag="Screenshots" Name="Screenshots"/>
                <TabItem Header="{DynamicResource Draw.Instance.Tab.Servers}" Tag="Server" Name="Server"/>
                <TabItem Header="{DynamicResource Draw.Instance.Tab.Plugins}" Tag="Plugin" Name="Plugin" IsVisible="False"/>
                <TabItem Header="{DynamicResource Draw.Instance.Tab.Controls}" Tag="Controls" Name="GameControls" />
            </TabControl>

            <navigation:NavigationFrame Grid.Row="1"
                                        Margin="5,5,10,0"
                                        Name="InstanceFrame" />
        </Grid>
    </Grid>
</UserControl>