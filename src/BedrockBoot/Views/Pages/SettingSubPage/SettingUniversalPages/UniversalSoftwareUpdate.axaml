<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.SettingSubPage.SettingUniversalPages.UniversalSoftwareUpdate">
    <ScrollViewer>
        <Grid Margin="15"
              RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0">
                <onePointControls:SettingCard Header="自动更新"
                                              Description="在每次启动时都检测更新"
                                              Margin="5"
                                              Glyph="&#xE965;">
                    <ToggleSwitch IsChecked="True"></ToggleSwitch>
                </onePointControls:SettingCard>
            </StackPanel>
            
            <Grid Grid.Row="1">
                <notice:InfoCard HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Glyph="&#xEC61;"
                                 BigTitle="当前已是最新版本"
                                 Message="尽情享用吧~"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
