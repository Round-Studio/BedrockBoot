<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:colorCode="clr-namespace:BedrockBoot.Models.Style.ColorCode"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Control.Items.Instance.Mods.ArkeShaderPackItem">
    <onePointControls:SettingExpander Name="Card"
                                      Glyph="&#xF012;">
        <onePointControls:SettingExpander.Header>
            <colorCode:MinecraftTextBlock Name="Header"
                                          FontSize="14"/>
        </onePointControls:SettingExpander.Header>
        <StackPanel>
            <onePointControls:SettingCard IsClickable="True"
                                          Header="删除包"
                                          Glyph=""
                                          Click="SettingCard_OnClick"></onePointControls:SettingCard>
        </StackPanel>
    </onePointControls:SettingExpander>
</UserControl>
