<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.DialogContent.Chunker.DialogChooseChunkerTypeContent">
    <StackPanel Width="360"
                Spacing="8">
        <onePointControls:SettingCard Header="{DynamicResource Chunker.ChooseType.B2J.Title}"
                                      Description="{DynamicResource Chunker.ChooseType.B2J.Desc}"
                                      Name="BedrockToJava"
                                      Click="BedrockToJava_OnClick"
                                      IsClickable="True"
                                      Glyph="&#xE945;" />

        <onePointControls:SettingCard Header="{DynamicResource Chunker.ChooseType.J2B.Title}"
                                      Description="{DynamicResource Chunker.ChooseType.J2B.Desc}"
                                      Name="JavaToBedrock"
                                      Click="JavaToBedrock_OnClick"
                                      IsClickable="True"
                                      Glyph="&#xE945;" />
    </StackPanel>
</UserControl>