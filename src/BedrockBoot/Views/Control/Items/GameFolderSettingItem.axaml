<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800"
             x:Class="BedrockBoot.Views.Control.Items.GameFolderSettingItem">
    <onePointControls:SettingExpander Description="FolderPath"
                                      Name="Card"
                                      IsFontIcon="True"
                                      Glyph="&#xE8B7;">
        <onePointControls:SettingExpander.Header>
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="4">
                <onePointControls:LabelBox VerticalAlignment="Center"
                                           IsVisible="True"
                                           Name="FolderType"
                                           Text="Folder Type"></onePointControls:LabelBox>
                <TextBlock FontSize="16"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Name="FolderNameBox">
                    Folder Name
                </TextBlock>
            </StackPanel>
        </onePointControls:SettingExpander.Header>
        <StackPanel>
            <onePointControls:SettingCard Header="打开目录"
                                          Glyph="&#xE8B7;"
                                          Name="OpenFolderBtn"
                                          IsClickable="True"
                                          Click="OpenFolderBtn_OnClick"></onePointControls:SettingCard>
            <onePointControls:SettingCard Header="设置目录"
                                          Glyph="&#xE713;"
                                          IsClickable="True"
                                          Name="SettingBtn"
                                          Click="SettingBtn_OnClick"></onePointControls:SettingCard>
            <onePointControls:SettingCard Header="删除目录"
                                          Glyph="&#xE74D;"
                                          IsClickable="True"
                                          Name="DeleteFolderBtn"
                                          Click="DeleteFolderBtn_OnClick"></onePointControls:SettingCard>
        </StackPanel>
    </onePointControls:SettingExpander>
</UserControl>