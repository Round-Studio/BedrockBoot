<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Control.Items.SearchItem">
    <onePointControls:SettingCard IsClickable="True"
                                  Name="Card"
                                  Glyph="&#xE91B;"
                                  Description="Description">
        <onePointControls:SettingCard.Header>
            <StackPanel Orientation="Horizontal"
                        Name="HeaderBox"
                        Spacing="8">
                <TextBlock Name="ItemName"
                           Text="ItemName"></TextBlock>
            </StackPanel>
        </onePointControls:SettingCard.Header>
    </onePointControls:SettingCard>
</UserControl>
