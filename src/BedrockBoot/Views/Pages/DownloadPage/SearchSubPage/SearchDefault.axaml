<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:widgets="clr-namespace:BedrockBoot.Views.Control.Widgets"
             xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
             d:DesignWidth="800" d:DesignHeight="400"
             x:Class="BedrockBoot.Views.Pages.DownloadPage.SearchSubPage.SearchDefault">
    <Grid ColumnDefinitions="2.5*,7.5*"
          ColumnSpacing="0"
          Margin="20,5,20,20">
        <Grid Grid.Column="0"
              RowDefinitions="Auto,*"
              RowSpacing="8">
            <Grid Grid.Row="0"
                  Height="24">
                <onePointControls:LineTextBlock Margin="0"
                                                Text="历史记录"
                                                FontSize="16"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center" />

                <Button Classes="NoBorder"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Padding="4"
                        Width="24" Height="24"
                        Margin="0,0,16,0"
                        Name="CleanBtn"
                        Click="CleanBtn_OnClick">
                    <onePointControls:FontIcon Glyph="&#xE74D;" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Name="HistoryListScrollViewer">
                <StackPanel Spacing="8"
                            Margin="0,0,16,0"
                            Name="HistoryList" />
            </ScrollViewer>

            <notice:InfoCard Grid.Row="1"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             Name="NoneBox"
                             BigTitle="空"
                             Message="没有历史搜索记录" />
        </Grid>

        <StackPanel Grid.Column="1" Spacing="10">
            <items:BorderCard Name="VersionCard">
                <Grid RowDefinitions="Auto,*">
                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Classes="NoBorder" Click="GameListBtn_OnClick" Padding="6,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <onePointControls:FontIcon VerticalAlignment="Center" Glyph="&#xE8FD;" />
                                <TextBlock Text="{DynamicResource Download.Search.Action.VersionList}" />
                            </StackPanel>
                        </Button>
                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Download.Search.Group.Latest}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid Grid.Row="1" IsVisible="False" Name="RecommendationPanel" ColumnDefinitions="*,*"
                          ColumnSpacing="6">
                        <widgets:SmallGameView Grid.Column="0" Name="ReleaseBtn" Click="ReleaseBtn_OnClick"
                                               Icon="avares://Round.SDK.Avalonia/Image/Icon/mc_grassblock_neo.png" />
                        <widgets:SmallGameView Grid.Column="1" Name="PreviewBtn" Click="PreviewBtn_OnClick"
                                               Icon="avares://Round.SDK.Avalonia/Image/Icon/mc_soilblock_neo.png" />
                    </Grid>

                    <Border Grid.Row="1" Height="44">
                        <onePointControls:ProgressRing Name="LoadRing" HorizontalAlignment="Center" Height="36"
                                                       Width="36" />
                    </Border>
                </Grid>
            </items:BorderCard>

            <items:BorderCard Name="ResourceCard">
                <Grid RowDefinitions="Auto,*">
                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Classes="NoBorder" Click="SearchRes_OnClick" Padding="6,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <onePointControls:FontIcon VerticalAlignment="Center" Glyph="&#xE721;" />
                                <TextBlock Text="搜索资源" />
                            </StackPanel>
                        </Button>
                        <TextBlock DockPanel.Dock="Left" Text="热门资源" VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid Grid.Row="1" Name="RecommendationGrid" IsVisible="False" ColumnDefinitions="*,*"
                          ColumnSpacing="6">
                        <widgets:BigResourceButton Grid.Column="0" Name="BigResourceBtn" />
                        <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="6">
                            <widgets:SmallResourceButton Grid.Row="0" Name="SmallResourceBtn1" />
                            <widgets:SmallResourceButton Grid.Row="1" Name="SmallResourceBtn2" />
                        </Grid>
                    </Grid>

                    <Border Grid.Row="1" Height="122">
                        <onePointControls:ProgressRing Name="ResourceLoadRing" HorizontalAlignment="Center" Height="36"
                                                       Width="36" />
                    </Border>
                </Grid>
            </items:BorderCard>

            <StackPanel HorizontalAlignment="Center"
                        Opacity="0.6">
                <TextBlock Text="如某一项资源无法加载，可通过手动输入关键词进行搜索"
                           HorizontalAlignment="Center"
                           FontSize="9" />
                <TextBlock Text="如还是无法进行搜素，请前往 设置>下载 中切换列表源"
                           HorizontalAlignment="Center"
                           FontSize="9" />
            </StackPanel>
        </StackPanel>

        <notice:InfoCard Grid.Column="1" Name="NetworkErrorNotice" IsVisible="False" BigTitle="无效的网络连接" Message="无法连接至目标服务器"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
    </Grid>
</UserControl>