<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.InstanceSubPage.DrawContent.InstancePack">
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto">
            <items:BorderCard Grid.Column="0"
                              Margin="20,8,12,10"
                              Padding="10,0">
                <ListBox Classes="Segmented"
                         Name="TypeSel"
                         SelectedIndex="0"
                         SelectionChanged="SelectingItemsControl_OnSelectionChanged">
                    <ListBoxItem Classes="Segmented"
                                 Tag="Resource">
                        <StackPanel Orientation="Horizontal">
                            <onePointControls:FontIcon Glyph="&#xF133;"
                                                       VerticalAlignment="Center"
                                                       FontSize="16"></onePointControls:FontIcon>
                            <TextBlock Margin="8,4,0,4">资源包</TextBlock>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Classes="Segmented"
                                 Tag="Behavior">
                        <StackPanel Orientation="Horizontal">
                            <onePointControls:FontIcon Glyph="&#xF156;"
                                                       VerticalAlignment="Center"
                                                       FontSize="16"></onePointControls:FontIcon>
                            <TextBlock Margin="8,4,0,4">行为包</TextBlock>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </items:BorderCard>
            <items:BorderCard Grid.Column="1"
                              Margin="0,8,12,10">
                <Grid ColumnDefinitions="*">
                    <DockPanel HorizontalAlignment="Stretch"
                               LastChildFill="True">
                        <onePointControls:FontIcon Glyph="&#xE71E;"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   Margin="5,5,12,5"></onePointControls:FontIcon>
                        <TextBox Name="SearchBox"
                                 HorizontalAlignment="Stretch"
                                 TextChanged="SearchBox_OnTextChanged"
                                 DockPanel.Dock="Right"></TextBox>
                    </DockPanel>
                </Grid>
            </items:BorderCard>
            <items:BorderCard Grid.Column="2"
                              Margin="0,8,20,10">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Button Classes="NoBorder"
                                Name="ImportPackBtn"
                                Click="ImportPackBtn_OnClick"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <onePointControls:FontIcon Glyph="&#xE710;"
                                                           VerticalAlignment="Center"
                                                           Margin="0,1,8,0"></onePointControls:FontIcon>
                                <TextBlock>导入包</TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </items:BorderCard>
        </Grid>
        
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="15,0,15,15"
                       HorizontalAlignment="Stretch"
                       Name="ResultBox">
            </StackPanel>
        </ScrollViewer>
        
        <notice:InfoCard Grid.Row="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Name="NullBox"
                         IsVisible="False"
                         BigTitle="空空如也"
                         Message="输入的关键词无效 或 这个实例没有包"/>
    </Grid>
</UserControl>
