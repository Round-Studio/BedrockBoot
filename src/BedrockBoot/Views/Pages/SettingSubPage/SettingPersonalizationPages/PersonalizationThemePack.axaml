<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.SettingSubPage.SettingPersonalizationPages.PersonalizationThemePack">
    <Grid Margin="0,15">
        <Grid ColumnDefinitions="3*,7*">
            <StackPanel Grid.Column="0"
                        Margin="20,0,0,0"
                        Spacing="8">
                <TextBlock FontWeight="Bold"
                           FontSize="14"
                           Text="{DynamicResource Settings.Universal.Exception.Summary.Title}" />

                <TextBlock Text="{DynamicResource Settings.Personalization.ThemePack.Desc1}"
                           TextWrapping="Wrap"
                           Opacity="0.8" />

                <TextBlock Text="{DynamicResource Settings.Personalization.ThemePack.Desc2}"
                           TextWrapping="Wrap"
                           Opacity="0.8" />

                <Button Padding="8"
                        Name="ImportThemePack"
                        Click="ImportThemePack_OnClick">
                    <StackPanel Orientation="Horizontal"
                                Spacing="12">
                        <onePointControls:FontIcon VerticalAlignment="Center"
                                                   Glyph="&#xE710;" />
                        <TextBlock Text="{DynamicResource Settings.Personalization.ThemePack.Action.Import}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <ListBox Grid.Column="1"
                     Margin="10,0,20,0"
                     Name="PacksList"
                     SelectionChanged="PacksList_OnSelectionChanged">
                
            </ListBox>

            <notice:InfoCard Grid.Column="1"
                             Name="InfoCard"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             BigTitle="{DynamicResource Settings.Personalization.ThemePack.Empty.Title}"
                             Message="{DynamicResource Settings.Personalization.ThemePack.Empty.Message}" />

            <notice:LoadCard Grid.Column="1"
                             Name="LoadingCard"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             BigTitle="{DynamicResource Shared.Status.Wait}"
                             Message="{DynamicResource Settings.Personalization.ThemePack.Loading.Message}" />
        </Grid>
    </Grid>
</UserControl>
