<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.DownloadSubPage.CurseForge.CurseForgePackBuildFile">
    <Grid>
        <ScrollViewer>
            <StackPanel Margin="20,0,20,15"
                        Spacing="8"
                        Name="List" />
        </ScrollViewer>

        <notice:LoadCard HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         BigTitle="{DynamicResource Download.Assets.Status.Loading.Title}"
                         Message="{DynamicResource Download.Assets.Status.Loading.Message}"
                         Name="LoadingRing" />

        <notice:InfoCard VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Glyph="&#xE822;"
                         BigTitle="{DynamicResource Shared.Status.Error.Title}"
                         Message="{DynamicResource Shared.Status.Error.Network.Desc}"
                         Name="NoneBox" />
    </Grid>
</UserControl>