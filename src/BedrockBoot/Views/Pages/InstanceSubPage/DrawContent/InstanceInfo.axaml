<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             xmlns:widgets="clr-namespace:BedrockBoot.Views.Control.Widgets"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.InstanceSubPage.DrawContent.InstanceInfo">
    <Grid>
        <ScrollViewer>
            <StackPanel Margin="20,0,20,15"
                        Spacing="8">
                <items:BorderCard Padding="0"
                                  ClipToBounds="True">
                    <Grid Height="240">
                        <widgets:LocalImageRenderWidget Name="IconBox" />

                        <Border CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="Black" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Spacing="8"
                                    Margin="8">
                            <Button Classes="NoBorder"
                                    Name="ResetImageBtn"
                                    Click="ResetImageBtn_OnClick"
                                    Padding="8">
                                <onePointControls:FontIcon Glyph="&#xE777;" />
                            </Button>
                            <Button Classes="NoBorder"
                                    Name="ChooseNewImageBtn"
                                    Click="ChooseNewImageBtn_OnClick"
                                    Padding="8">
                                <onePointControls:FontIcon Glyph="&#xE8AB;" />
                            </Button>
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto, *, Auto" Margin="30">
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                                <TextBlock FontSize="32"
                                           FontWeight="Black"
                                           Foreground="White"
                                           Name="VersionName"
                                           Text="VERSION NAME"
                                           LetterSpacing="1" />

                                <StackPanel Orientation="Horizontal" Spacing="15" Opacity="0.8">
                                    <TextBlock FontSize="13"
                                               Foreground="#66C0F4"
                                               FontWeight="SemiBold"
                                               Name="VersionReady"
                                               Text="READY TO LAUNCH" />

                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <onePointControls:FontIcon FontSize="14" Glyph="&#xE916;" Foreground="White" />
                                        <TextBlock FontSize="13" Foreground="White" Name="TotalDuration"
                                                   Text="120 HOURS" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Bottom"
                                        Orientation="Horizontal"
                                        Spacing="10">

                                <Button Name="LaunchBtn"
                                        Click="LaunchBtn_OnClick"
                                        Width="160"
                                        Height="50"
                                        CornerRadius="4"
                                        BorderThickness="0"
                                        Classes="Accent">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <onePointControls:FontIcon Glyph="&#xE768;"
                                                                   FontSize="18"
                                                                   Foreground="White"
                                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Shared.Action.Launch}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="White" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </items:BorderCard>

                <TextBlock FontWeight="Bold"
                           FontSize="14"
                           Text="{DynamicResource Settings.Game.Group.Base}" />

                <onePointControls:SettingCard Glyph="&#xE8AC;"
                                              Header="{DynamicResource Instance.Info.Name.Title}"
                                              Description="{DynamicResource Instance.Info.Name.Desc}">
                    <TextBox Width="200"
                             Name="InstanceName"
                             TextChanged="TextTypeConfig_OnChanged" />
                </onePointControls:SettingCard>

                <onePointControls:SettingCard Glyph="&#xEB9F;"
                                              Name="GameIconCard"
                                              Header="{DynamicResource Instance.Info.Icon.Title}"
                                              Description="{DynamicResource Instance.Info.Icon.Desc}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Border CornerRadius="6"
                                Height="74"
                                Width="74"
                                ClipToBounds="True">
                            <Image Source="avares://BedrockBoot/Assets/Icon/Logo/Grass.png" 
                                   Name="GameIcon"/>
                        </Border>
                        
                        <StackPanel Spacing="8"
                                    MaxWidth="200"
                                    Width="200">
                            <ComboBox Name="GameIconSel"
                                      Width="200"
                                      SelectionChanged="GameIconSel_OnSelectionChanged"
                                      SelectedIndex="1">
                                <ComboBoxItem Content="自定义" />
                                <ComboBoxItem Content="默认" />
                                <ComboBoxItem Content="草方块" />
                                <ComboBoxItem Content="草经" />
                                <ComboBoxItem Content="工作台" />
                                <ComboBoxItem Content="圆石" />
                                <ComboBoxItem Content="末地石" />
                            </ComboBox>
                        
                            <DockPanel HorizontalSpacing="8"
                                       Name="CustomizationBox">
                                <Button DockPanel.Dock="Right"
                                        Content="选择"
                                        Padding="8"
                                        Name="IconPathChooseBtn"
                                        Click="IconPathChooseBtn_OnClick"></Button>
                                <TextBox Name="IconPathInput"></TextBox>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </onePointControls:SettingCard>

                <TextBlock FontWeight="Bold"
                           FontSize="14"
                           Text="{DynamicResource Instance.Info.Group.Launch}" />
                <onePointControls:SettingCard Glyph="&#xEC06;"
                                              Header="{DynamicResource Instance.Info.Launch.Args.Title}"
                                              Description="{DynamicResource Instance.Info.Launch.Args.Desc}">
                    <TextBox Width="200"
                             Name="InstanceArgs"
                             TextChanged="TextTypeConfig_OnChanged" />
                </onePointControls:SettingCard>

                <onePointControls:SettingCard Glyph="&#xE70F;"
                                              Header="{DynamicResource Instance.Info.Launch.EditMode.Title}"
                                              Description="{DynamicResource Instance.Info.Launch.EditMode.Desc}">
                    <ToggleSwitch Name="InstanceEdit"
                                  IsCheckedChanged="BoolTypeConfig_OnChanged" />
                </onePointControls:SettingCard>

                <onePointControls:SettingCard Glyph="&#xE822;"
                                              Header="{DynamicResource Instance.Info.Launch.Mods.Title}"
                                              Description="{DynamicResource Instance.Info.Launch.Mods.Desc}">
                    <ToggleSwitch Name="InstanceMod"
                                  IsCheckedChanged="BoolTypeConfig_OnChanged" />
                </onePointControls:SettingCard>

                <onePointControls:SettingCard Glyph="&#xE756;"
                                              Header="{DynamicResource Settings.Universal.Debug.Console.Title}"
                                              Description="{DynamicResource Instance.Info.Launch.Console.Desc}">
                    <ToggleSwitch Name="InstanceConsole"
                                  IsCheckedChanged="BoolTypeConfig_OnChanged" />
                </onePointControls:SettingCard>

                <onePointControls:SettingCard Glyph="&#xE8A1;"
                                              Header="{DynamicResource Instance.Info.Launch.DetailedLogs.Title}"
                                              Description="{DynamicResource Instance.Info.Launch.DetailedLogs.Desc}">
                    <ToggleSwitch Name="InstanceDetailedLogs"
                                  IsCheckedChanged="BoolTypeConfig_OnChanged" />
                </onePointControls:SettingCard>
                    
                <onePointControls:SettingCard Glyph="&#xEBE8;"
                                              Name="IsNativeExceptionCard"
                                              Header="Native 异常捕获"
                                              Description="捕获 Native 异常">
                    <ToggleSwitch IsChecked="False"
                                  Name="IsNativeException"
                                  IsCheckedChanged="BoolTypeConfig_OnChanged" />
                </onePointControls:SettingCard>
                    
                <onePointControls:SettingCard Glyph="&#xE7EF;"
                                              Name="IsRunAdminCard"
                                              Header="以管理员身份运行游戏"
                                              Description="启动游戏使用系统管理员权限运行游戏，效果与右键以管理员运行一致">
                    <ToggleSwitch IsChecked="False"
                                  Name="IsRunAdmin"
                                  IsCheckedChanged="BoolTypeConfig_OnChanged" />
                </onePointControls:SettingCard>
                
                <TextBlock FontWeight="Bold"
                           Name="HighLevel"
                           FontSize="14"
                           Text="{DynamicResource Settings.Download.Group.Advanced}" />
                
                <StackPanel>
                    <TextBlock Text="当前版本的 BedrockBoot 尚不支持为 UWP 类型的游戏进行版本隔离。"
                               Opacity="0.6" />
                
                    <DockPanel>
                
                        <TextBlock Text="详情可参见："
                                   Opacity="0.6" />
                
                        <HyperlinkButton NavigateUri="https://github.com/Round-Studio/BedrockBoot/issues/74"
                                         Content="https://github.com/Round-Studio/BedrockBoot/issues/74"></HyperlinkButton>
                    </DockPanel>
                </StackPanel>
                
                <onePointControls:SettingCard Glyph="&#xECAF;"
                                              Header="同步配置"
                                              Description="同步全局游戏设置 (options.txt)">
                    <ToggleSwitch IsChecked="True"
                                  Name="GameConfigSwitch"
                                  IsCheckedChanged="BoolTypeConfig_OnChanged" />
                </onePointControls:SettingCard>

                <StackPanel Spacing="8"
                            Name="InstanceIsolationPanel">
                    <onePointControls:SettingCard Glyph="&#xE7B8;"
                                                  Name="IsolationCard"
                                                  Header="{DynamicResource Settings.Game.Isolation.Title}"
                                                  Description="{DynamicResource Instance.Info.Isolation.Desc}">
                        <ToggleSwitch IsChecked="True"
                                      Name="InstanceIsolated"
                                      IsCheckedChanged="BoolTypeConfig_OnChanged" />
                    </onePointControls:SettingCard>

                    <onePointControls:SettingCard Header="隔离目录"
                                                  Description="选择不同的目录隔离策略"
                                                  Glyph="&#xEC25;">
                        <ComboBox Width="200"
                                  Name="CatalogStrategy"
                                  SelectionChanged="CatalogStrategy_OnSelectionChanged"
                                  SelectedIndex="2">
                            <ComboBoxItem Content="跟随全局" />
                            <ComboBoxItem Content="独立目录 (专属目录)" />
                            <ComboBoxItem Content="与其他启动器共享" />
                        </ComboBox>
                    </onePointControls:SettingCard>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>