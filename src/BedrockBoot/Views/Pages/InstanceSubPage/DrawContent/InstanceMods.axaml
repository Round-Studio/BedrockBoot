<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.InstanceSubPage.DrawContent.InstanceMods">
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto">
            <items:BorderCard Grid.Column="0"
                              Margin="20,0,0,10">
                <DockPanel HorizontalAlignment="Stretch"
                           LastChildFill="True">
                    <onePointControls:FontIcon Glyph="&#xEA86;"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               Margin="5,5,12,5" />
                    <ComboBox Width="200"
                              Name="ModsLoaderSelect"
                              SelectionChanged="ModsLoaderSelect_OnSelectionChanged"
                              SelectedIndex="0">
                    </ComboBox>
                </DockPanel>
            </items:BorderCard>
            <items:BorderCard Grid.Column="1"
                              Margin="12,0,12,10">
                <Grid ColumnDefinitions="*">
                    <DockPanel HorizontalAlignment="Stretch"
                               LastChildFill="True">
                        <onePointControls:FontIcon Glyph="&#xE71E;"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   Margin="5,5,12,5" />
                        <TextBox Name="SearchBox"
                                 Watermark="键入关键词以搜索"
                                 HorizontalAlignment="Stretch"
                                 TextChanged="SearchBox_OnTextChanged"
                                 DockPanel.Dock="Right" />
                    </DockPanel>
                </Grid>
            </items:BorderCard>
            <items:BorderCard Grid.Column="2"
                              Margin="0,0,20,10">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Button Classes="NoBorder"
                                Name="FolderBtn"
                                Click="FolderBtn_OnClick"
                                Width="32"
                                Height="32">
                            <onePointControls:FontIcon Glyph="&#xE8B7;"
                                                       VerticalAlignment="Center" />
                        </Button>

                        <Button Classes="NoBorder"
                                Name="ImportModBtn"
                                Click="ImportModBtn_OnClick"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <onePointControls:FontIcon Glyph="&#xE710;"
                                                           VerticalAlignment="Center"
                                                           Margin="0,1,8,0" />
                                <TextBlock Text="{DynamicResource Instance.Mods.Action.Import}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </items:BorderCard>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="15,0,15,15"
                        HorizontalAlignment="Stretch"
                        Name="ResultBox" />
        </ScrollViewer>

        <notice:InfoCard Grid.Row="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Name="NullBox"
                         IsVisible="False"
                         BigTitle="{DynamicResource Instance.Mods.Empty.Title}"
                         Message="{DynamicResource Instance.Mods.Empty.Message}" />
    </Grid>
</UserControl>