<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.SetupPage.SetupLayout">
    <StackPanel VerticalAlignment="Center"
                Margin="45">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Top">
            <onePointControls:FontIcon Margin="5"
                                       FontSize="28"
                                       HorizontalAlignment="Center"
                                       Glyph="&#xECA5;"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}" />
            <TextBlock FontSize="22"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"
                       Text="布局" />
            <TextBlock Margin="5"
                       HorizontalAlignment="Center"
                       Text="调整启动器主页面的布局" />
        </StackPanel>

        <Grid Margin="0,10,0,0"
              HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <ComboBox Margin="5"
                          Width="320"
                          Height="36"
                          Name="IsRightLaunchButton"
                          SelectionChanged="IsRightLaunchButton_OnSelectionChanged"
                          SelectedIndex="0">
                    <ComboBoxItem Content="启动按钮靠左" />
                    <ComboBoxItem Content="启动按钮靠右" />
                </ComboBox>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
