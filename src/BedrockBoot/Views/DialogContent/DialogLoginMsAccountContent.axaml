<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d"
             x:Class="BedrockBoot.Views.DialogContent.DialogLoginMsAccountContent">
    <Grid MinWidth="320">
        <StackPanel Spacing="8">
            <onePointControls:FontIcon Glyph="&#xf164;"
                                       HorizontalAlignment="Center"
                                       FontSize="32" />
            <TextBlock Text="{DynamicResource Dialog.LoginMicrosoft.Title}"
                       HorizontalAlignment="Center"
                       FontSize="16">
            </TextBlock>

            <Button Classes="NoBorder"
                    Padding="12,4"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    IsEnabled="False"
                    Click="CodeCopyBtn_OnClick"
                    Name="CodeCopyBtn"
                    Content="{DynamicResource Dialog.LoginMicrosoft.Status.Loading}">
            </Button>

            <StackPanel Name="LinkBox"
                        Spacing="8"
                        IsVisible="False">
                <TextBlock Text="{DynamicResource Dialog.LoginMicrosoft.CopyHint}"
                           FontSize="11"
                           Opacity="0.6"
                           HorizontalAlignment="Center">
                </TextBlock>

                <DockPanel HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource Dialog.LoginMicrosoft.BrowserNotOpened}"
                               FontSize="11"
                               Opacity="0.6"
                               HorizontalAlignment="Center">
                    </TextBlock>
                    <HyperlinkButton Content="{DynamicResource Dialog.LoginMicrosoft.Action.OpenBrowser}"
                                     Name="LinkBtn"
                                     FontSize="11">
                    </HyperlinkButton>
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>