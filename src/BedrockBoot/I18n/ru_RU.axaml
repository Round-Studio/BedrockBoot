    <x:String x:Key="Multiplayer.Lobby.CreateRoom.Desc">Создайте свою комнату и пригласите друзей присоединиться.</x:String>
    <x:String x:Key="Multiplayer.Lobby.JoinRoom.Title">Присоединиться к комнате</x:String>
    <x:String x:Key="Multiplayer.Lobby.JoinRoom.Desc">Присоединяйтесь к комнате друга и войдите в игру</x:String>
    <x:String x:Key="Multiplayer.Lobby.RoomCode">Код номера</x:String>
