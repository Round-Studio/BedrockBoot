<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.SettingSubPage.SettingGame">
    <ScrollViewer>
        <StackPanel Margin="15"
                    Spacing="8">
            <TextBlock Margin="5,0"
                       FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Settings.Game.Group.Base}" />

            <onePointControls:SettingCard Margin="5, 0"
                                          Name="IsolationCard"
                                          Header="{DynamicResource Settings.Game.Isolation.Title}"
                                          Description="{DynamicResource Settings.Game.Isolation.Desc}"
                                          Glyph="&#xE7B8;">
                <ComboBox Width="200"
                          Name="IsolationTypeBox"
                          SelectionChanged="IsolationTypeBox_OnSelectionChanged">
                    <!--<ComboBoxItem Content="{DynamicResource Settings.Game.Isolation.SymbolicLink}" />-->
                    <!--<ComboBoxItem Content="{DynamicResource Settings.Game.Isolation.HookSymbolicLink}" />-->
                    <ComboBoxItem Content="Hook" />
                </ComboBox>
            </onePointControls:SettingCard>

            <onePointControls:SettingCard Margin="5, 0"
                                          Header="{DynamicResource Settings.Game.IsolationPriority.Title}"
                                          Description="{DynamicResource Settings.Game.IsolationPriority.Desc}"
                                          Glyph="&#xE964;">
                <ComboBox Width="200"
                          SelectedIndex="1"
                          Name="IsolationPriority"
                          SelectionChanged="IsolationPriority_OnSelectionChanged">
                    <ComboBoxItem Content="{DynamicResource Settings.Game.IsolationPriority.Standard}" />
                    <ComboBoxItem Content="{DynamicResource Settings.Game.IsolationPriority.Priority}" />
                </ComboBox>
            </onePointControls:SettingCard>

            <onePointControls:SettingCard Margin="5, 0"
                                          Header="{DynamicResource Settings.Game.CatalogStrategy.Title}"
                                          Description="{DynamicResource Settings.Game.CatalogStrategy.Desc}"
                                          Glyph="&#xEC25;">
                <ComboBox Width="200"
                          Name="CatalogStrategy"
                          SelectionChanged="CatalogStrategy_OnSelectionChanged"
                          SelectedIndex="1">
                    <ComboBoxItem Content="{DynamicResource Settings.Game.CatalogStrategy.Dedicated}" />
                    <ComboBoxItem Content="{DynamicResource Settings.Game.CatalogStrategy.Shared}" />
                </ComboBox>
            </onePointControls:SettingCard>

            <onePointControls:SettingCard Margin="5, 0"
                                          Header="{DynamicResource Settings.Download.InstancePath.Title}"
                                          Description="{DynamicResource Settings.Download.InstancePath.Desc}"
                                          Name="GameFolderBtn"
                                          Click="GameFolderBtn_OnClick"
                                          IsClickable="True"
                                          Glyph="&#xE8B7;" />

            <StackPanel Name="HelperPanel"
                        Spacing="8">
                <TextBlock Margin="5,0"
                           FontWeight="Bold"
                           FontSize="14"
                           Text="{DynamicResource Settings.Game.Group.Accessibility}" />

                <onePointControls:SettingCard Margin="5, 0"
                                              Header="{DynamicResource Settings.Game.Overlay.Title}"
                                              Description="{DynamicResource Settings.Game.Overlay.Desc}"
                                              Glyph="&#xF156;">
                    <ToggleSwitch Name="IsOpenGameLayering"
                                  IsCheckedChanged="IsOpenGameLayering_OnIsCheckedChanged">
                    </ToggleSwitch>
                </onePointControls:SettingCard>

                <onePointControls:SettingCard Margin="5, 0"
                                              Name="MouseLockBtn"
                                              Click="MouseLockBtn_OnClick"
                                              IsClickable="True"
                                              Header="{DynamicResource Settings.Game.MouseLock.Title}"
                                              Description="{DynamicResource Settings.Game.MouseLock.Desc}"
                                              Glyph="&#xE72E;">
                </onePointControls:SettingCard>
            </StackPanel>

            <TextBlock Margin="5,0"
                       FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Settings.Game.Group.Global}" />

            <onePointControls:SettingCard Margin="5, 0"
                                          IsClickable="True"
                                          Glyph="&#xECAF;"
                                          Name="PublicSyncBtn"
                                          Click="PublicSyncBtn_OnClick"
                                          Header="{DynamicResource Settings.Game.PublicSync.Title}"
                                          Description="{DynamicResource Settings.Game.PublicSync.Desc}" />

            <onePointControls:SettingCard Margin="5, 0"
                                          IsClickable="True"
                                          Glyph="&#xE74E;"
                                          Name="SaveBackupBtn"
                                          Click="SaveBackupBtn_OnClick"
                                          Header="{DynamicResource Settings.Game.Backup.Title}"
                                          Description="{DynamicResource Settings.Game.Backup.Desc}" />

            <TextBlock Margin="5,0"
                       FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Settings.Game.Group.Advanced}" />

            <onePointControls:SettingCard Margin="5, 0"
                                          Header="{DynamicResource Settings.Game.LaunchCommand.Title}"
                                          Description="{DynamicResource Settings.Game.LaunchCommand.Desc}"
                                          Name="LaunchCommandBtn"
                                          Click="LaunchCommandBtn_OnClick"
                                          IsClickable="True"
                                          Glyph="&#xE756;" />

            <onePointControls:SettingCard Margin="5, 0"
                                          Name="IsUseNeoLaunchBox"
                                          Header="{DynamicResource Settings.Game.NeoLaunch.Title}"
                                          Description="{DynamicResource Settings.Game.NeoLaunch.Desc}"
                                          Glyph="&#xEBD2;">
                <ToggleSwitch Name="IsUseNeoLaunchToggleSwitch"
                              IsEnabled="False"
                              IsCheckedChanged="IsUseNeoLaunchToggleSwitch_OnIsCheckedChanged">
                </ToggleSwitch>
            </onePointControls:SettingCard>

            <onePointControls:SettingCard Margin="5, 0"
                                          Header="Proton"
                                          Description="{DynamicResource Settings.Game.Proton.Desc}"
                                          Name="ProtonBtn"
                                          Click="ProtonBtn_OnClick"
                                          IsClickable="True"
                                          Glyph="&#xE74C;" />
        </StackPanel>
    </ScrollViewer>
</UserControl>