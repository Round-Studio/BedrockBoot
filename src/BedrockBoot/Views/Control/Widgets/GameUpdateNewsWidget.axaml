<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Control.Widgets.GameUpdateNewsWidget">
    <Grid>
        <ScrollViewer>
            <StackPanel Margin="15"
                        Spacing="8"
                        Name="NewsList" />
        </ScrollViewer>

        <onePointControls:ProgressRing HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Name="LoadRing"
                                       Width="48"
                                       Height="48" />
    </Grid>
</UserControl>