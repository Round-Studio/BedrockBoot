<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.InstanceSubPage.DrawContent.InstanceLoaders">
    <Grid Margin="0,0,0,10" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Margin="20,0" Spacing="8" Orientation="Horizontal">
            <TextBlock Text="加载器" VerticalAlignment="Center" FontSize="16" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="8"
                        Name="LoadersList"
                        Margin="20,10,20,0">
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>