<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.SettingSubPage.SettingGame">
    <ScrollViewer>
        <StackPanel Margin="15"
                    Spacing="8">
            <TextBlock Margin="5,0"
                       FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Settings.Game.Group.Base}" />

            <onePointControls:SettingCard Margin="5, 0"
                                          Name="IsolationCard"
                                          Header="{DynamicResource Settings.Game.Isolation.Title}"
                                          Description="{DynamicResource Settings.Game.Isolation.Desc}"
                                          Glyph="&#xE7B8;">
                <ComboBox Width="300"
                          Name="IsolationTypeBox"
                          SelectionChanged="IsolationTypeBox_OnSelectionChanged">
                    <!--<ComboBoxItem Content="{DynamicResource Settings.Game.Isolation.SymbolicLink}" />-->
                    <ComboBoxItem Content="{DynamicResource Settings.Game.Isolation.HookSymbolicLink}" />
                </ComboBox>
            </onePointControls:SettingCard>

            <onePointControls:SettingCard Margin="5, 0"
                                          Name="MouseLockCard"
                                          Header="鼠标锁"
                                          Description="为了防止鼠标越过游戏窗口边界，导致误触其他东西的功能"
                                          Glyph="&#xE72E;">
                <ToggleSwitch Name="MouseLockSwitch"
                              IsCheckedChanged="MouseLockSwitch_OnIsCheckedChanged" />
            </onePointControls:SettingCard>

            <onePointControls:SettingCard Margin="5, 0"
                                          Header="{DynamicResource Settings.Download.InstancePath.Title}"
                                          Description="{DynamicResource Settings.Download.InstancePath.Desc}"
                                          Name="GameFolderBtn"
                                          Click="GameFolderBtn_OnClick"
                                          IsClickable="True"
                                          Glyph="&#xE8B7;" />
            
            <StackPanel Spacing="8"
                        Name="SeniorPanel">
                <TextBlock Margin="5,0"
                           FontWeight="Bold"
                           FontSize="14"
                           Text="高级" />

                <onePointControls:SettingCard Margin="5, 0"
                                              Header="Proton"
                                              Description="管理和设置 Proton 运行器"
                                              Name="ProtonBtn"
                                              Click="ProtonBtn_OnClick"
                                              IsClickable="True"
                                              Glyph="&#xE74C;" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>