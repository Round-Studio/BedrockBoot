<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.SetupPage.SetupImport">
    <StackPanel VerticalAlignment="Center"
                Margin="45">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Top">
            <onePointControls:FontIcon Margin="5"
                                       HorizontalAlignment="Center"
                                       FontSize="28"
                                       Glyph="&#xE8B7;"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}" />
            <TextBlock FontSize="22"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"
                       Text="{DynamicResource Setup.Import.Title}" />
            <TextBlock HorizontalAlignment="Center"
                       Margin="5"
                       Text="{DynamicResource Setup.Import.Description}" />
        </StackPanel>

        <Grid Margin="0,10,0,0"
              HorizontalAlignment="Center">
            <StackPanel Margin="5"
                        Width="320"
                        Spacing="10">
                <onePointControls:SettingCard Header="{DynamicResource Setup.Import.Folder.Header}"
                                              Description="{DynamicResource Setup.Import.Folder.Description}"
                                              Glyph="&#xECC8;"
                                              Name="ImportFolderBtn"
                                              Click="ImportFolderBtn_OnClick"
                                              IsClickable="True" />

                <onePointControls:SettingCard Header="{DynamicResource Setup.Import.Other.Header}"
                                              Description="导入第三方启动器目录"
                                              Glyph="&#xE835;"
                                              Name="ImportOtherLauncherBtn"
                                              Click="ImportOtherLauncherBtn_OnClick"
                                              IsClickable="True" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>