<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.DrawContent.DrawImportOtherLauncherContent">
    <Grid>
        <ScrollViewer>
            <StackPanel Name="LaunchersBox"
                        Spacing="10"
                        Margin="20" />
        </ScrollViewer>
        <notice:InfoCard BigTitle="{DynamicResource Draw.ImportLauncher.Status.None.Title}"
                         Message="{DynamicResource Draw.ImportLauncher.Status.None.Message}"
                         Name="NoneBox"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
    </Grid>
</UserControl>