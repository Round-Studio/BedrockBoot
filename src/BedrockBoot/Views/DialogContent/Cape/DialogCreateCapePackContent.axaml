<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="BedrockBoot.Views.DialogContent.Cape.DialogCreateCapePackContent">
    <StackPanel Spacing="8">
        <TextBlock Text="{DynamicResource Cape.Dialog.CreatePack.Name}" />
        <TextBox Width="200"
                 Watermark="{DynamicResource Cape.Dialog.CreatePack.Name}"
                 Name="PackName" />
        <TextBlock Text="{DynamicResource Cape.Dialog.CreatePack.Author}" />
        <TextBox Width="200"
                 Watermark="{DynamicResource Cape.Dialog.CreatePack.AuthorWatermark}"
                 Name="Author" />
        <TextBlock Text="{DynamicResource Cape.Dialog.CreatePack.IdHint}"
                   FontSize="12"
                   Opacity="0.6" />
    </StackPanel>
</UserControl>
