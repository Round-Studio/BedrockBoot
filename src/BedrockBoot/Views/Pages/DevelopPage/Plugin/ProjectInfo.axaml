<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:widgets="clr-namespace:BedrockBoot.Views.Control.Widgets"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.DevelopPage.Plugin.ProjectInfo">
    <Grid>
        <ScrollViewer Margin="0,0,5,0">
            <StackPanel Margin="0,0,15,0"
                        Spacing="8"
                        Name="ProjectStackPanel">
                <DockPanel>
                    <widgets:CopyTextBox Width="400"
                                         IsReadOnly="True"
                                         Name="CopyTextBox"
                                         DockPanel.Dock="Right"/>
                    <TextBlock Text="调试命令"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"></TextBlock>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
