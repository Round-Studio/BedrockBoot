<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <RuntimeIdentifier>android-x64</RuntimeIdentifier>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" Condition="'$(TargetFramework)' != 'net10.0-android'" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" Condition="'$(TargetFramework)' != 'net10.0-android'" />
    <PackageReference Include="Avalonia.Win32" Version="12.1.3" Condition="'$(TargetFramework)' != 'net10.0-android'" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Controls\DesktopThumbnailWindow.axaml.cs">
      <DependentUpon>DesktopThumbnailWindow.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
