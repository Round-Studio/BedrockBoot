<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800"
             x:Class="BedrockBoot.Views.Control.Items.Instance.ModLoaderItem">
    <onePointControls:SettingCard IsClickable="True"
                                  Name="LoaderCard"
                                  Glyph="&#xEA86;"
                                  Description="Loader Description">
        <onePointControls:SettingCard.Header>
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <TextBlock Name="LoaderName"
                           Text="LoaderName">
                </TextBlock>

                <onePointControls:LabelBox Name="LoaderInstallStatus"
                                           VerticalAlignment="Center"
                                           Text="未安装">
                </onePointControls:LabelBox>
            </StackPanel>
        </onePointControls:SettingCard.Header>
        <StackPanel Orientation="Horizontal"
                    Spacing="8">
            <onePointControls:LabelBox Text="不适用"
                                       FontSize="14"
                                       Background="DarkRed"
                                       Name="NotApplicableLabel"
                                       IsVisible="False"
                                       VerticalAlignment="Center">
            </onePointControls:LabelBox>
            <onePointControls:ProgressRing Name="LoadingRing"></onePointControls:ProgressRing>
            <ToggleSwitch VerticalAlignment="Center"
                          Name="IsEnableToggle"
                          IsCheckedChanged="IsEnableToggle_OnIsCheckedChanged"
                          IsVisible="False">
            </ToggleSwitch>
            <Button Classes="NoBorder"
                    Name="DeleteBtn"
                    IsVisible="False"
                    Width="32" Height="32">
                <onePointControls:FontIcon Glyph="&#xE74D;"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                </onePointControls:FontIcon>
            </Button>
        </StackPanel>
    </onePointControls:SettingCard>
</UserControl>