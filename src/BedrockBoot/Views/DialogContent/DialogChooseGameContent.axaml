<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="BedrockBoot.Views.DialogContent.DialogChooseGameContent">
    <StackPanel Spacing="10"
                Margin="5,0">
        <TextBlock
                   HorizontalAlignment="Left">游戏目录</TextBlock>
        <ComboBox Width="320"
                  Name="GameFolder"
                  SelectionChanged="GameFolder_OnSelectionChanged"></ComboBox>
        
        <TextBlock
                   HorizontalAlignment="Left">实例：</TextBlock>
        <ComboBox Width="320"
                  Name="GameInstance"></ComboBox>
    </StackPanel>
</UserControl>
