<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.MultiplayerPage.MultiplayerRoomGuest">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Spacing="8"
                    Margin="0,0,20,0"
                    Grid.Row="0">
            <TextBlock FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Multiplayer.Lobby.GuestJoinedTip}" />

            <onePointControls:SettingCard Header="{DynamicResource Multiplayer.Lobby.ExitRoom.Title}"
                                          Description="{DynamicResource Multiplayer.Lobby.ExitRoom.Desc}"
                                          IsClickable="True"
                                          Name="CloseBtn"
                                          Click="CloseBtn_OnClick"
                                          Glyph="&#xE711;" />

            <TextBlock FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Multiplayer.Lobby.ConnectedPlayers}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,8,5,0">
            <StackPanel Margin="0,0,15,0"
                        Spacing="8"
                        Name="PlayerList" />
        </ScrollViewer>
    </Grid>
</UserControl>