<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.SetupPage.SetupStyle">
    <StackPanel VerticalAlignment="Center"
                Margin="45">
        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Top">
            <onePointControls:FontIcon Margin="5"
                                       FontSize="28"
                                       Glyph="&#xE790;"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
            <TextBlock FontSize="22"
                       Margin="5,10,0,0"
                       Text="个性化"></TextBlock>
            <TextBlock Margin="5"
                       Text="启动器的个性化设置"></TextBlock>
        </StackPanel>
        
        <Grid Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <ComboBox Margin="5"
                          Width="460"
                          Height="36"
                          Name="ChooseThemeBox"
                          SelectionChanged="ChooseThemeBox_OnSelectionChanged"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Dark"></ComboBoxItem>
                    <ComboBoxItem Content="Light"></ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
