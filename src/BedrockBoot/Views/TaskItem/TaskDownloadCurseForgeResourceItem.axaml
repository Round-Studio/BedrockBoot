<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800"
             x:Class="BedrockBoot.Views.TaskItem.TaskDownloadCurseForgeResourceItem">
    <items:BorderCard>
        <Grid ColumnDefinitions="Auto,*,Auto">
            <onePointControls:ProgressRing Grid.Column="0"
                                           Width="36"
                                           Height="36"
                                           VerticalAlignment="Top"
                                           Margin="4,4,0,0"
                                           Background="Transparent" />
            <StackPanel Grid.Column="1" Margin="15,0,10,0"
                        HorizontalAlignment="Stretch">
                <TextBlock FontSize="16"
                           Name="CardTitle"
                           Text="{DynamicResource Task.CurseForge.Title}" />

                <StackPanel Margin="0,8,0,0"
                            HorizontalAlignment="Stretch">
                    <DockPanel>
                        <TextBlock Width="100" Text="{DynamicResource Task.CurseForge.Step.File}" />
                        <ProgressBar HorizontalAlignment="Stretch"
                                     IsIndeterminate="True"
                                     Name="DownloadProgressBar" />
                    </DockPanel>

                    <Grid ColumnDefinitions="*,*">
                        <TextBlock Grid.Column="0"
                                   Foreground="Gray"
                                   FontSize="9"
                                   Margin="0,2,0,0"
                                   Name="MainText" />

                        <TextBlock Grid.Column="1"
                                   Foreground="Gray"
                                   FontSize="9"
                                   Margin="0,2,0,0"
                                   Name="MainSpeedText">
                            0 B/s
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="2"
                    Classes="NoBorder"
                    Width="32" Height="32"
                    Name="CancelBtn"
                    Click="CancelButton_OnClick">
                <onePointControls:FontIcon Glyph="&#xE711;"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           FontSize="16" />
            </Button>
        </Grid>
    </items:BorderCard>
</UserControl>