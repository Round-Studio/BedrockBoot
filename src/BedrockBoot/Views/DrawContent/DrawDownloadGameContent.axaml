<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.DrawContent.DrawDownloadGameContent">
    <Grid Margin="10,0,10,10">
        <ScrollViewer>
            <StackPanel Margin="15,0,15,15">
                <TextBlock Margin="5"
                           FontWeight="Bold"
                           FontSize="14">基础设置</TextBlock>
                
                <onePointControls:SettingCard Margin="5"
                                              Glyph="&#xE8AC;"
                                              Header="实例名称"
                                              Description="实例在启动器内显示的名称">
                    <TextBox Width="400"
                             Name="InstallName"></TextBox>
                </onePointControls:SettingCard>
                
                <onePointControls:SettingCard Margin="5"
                                              Glyph="&#xE8B7;"
                                              Header="安装路径"
                                              Description="安装在哪些地方">
                    <ComboBox Width="400"
                              Name="InstallFolder"></ComboBox>
                </onePointControls:SettingCard>
                
                <TextBlock Margin="5"
                           FontWeight="Bold"
                           FontSize="14">高级设置</TextBlock>
                
                <onePointControls:SettingCard Margin="5"
                                              Glyph="&#xE821;"
                                              Header="使用 Appx 缓存"
                                              Description="是否使用先前缓存过的 Appx 进行游戏安装">
                    <ToggleSwitch IsEnabled="False"></ToggleSwitch>
                </onePointControls:SettingCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
