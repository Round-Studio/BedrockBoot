<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d"
             x:Class="BedrockBoot.Views.Control.Items.ArchiveItem">
    <onePointControls:SettingExpander ImageIcon="avares://BedrockBoot/Assets/Image/world-preview-flat-fixed-pixels.png"
                                      Name="SettingExpander"
                                      IsFontIcon="False">
        <onePointControls:SettingExpander.Header>
            <StackPanel Orientation="Horizontal">
                <onePointControls:LabelBox Text="项目"
                                           Name="ProjectLabel"></onePointControls:LabelBox>
                <TextBlock FontSize="15"
                           Name="WorldName">
                    My World
                </TextBlock>
            </StackPanel>
        </onePointControls:SettingExpander.Header>
        <StackPanel>
            <onePointControls:SettingCard Header="上次游玩时间"
                                          Glyph="">
                <TextBlock FontSize="11"
                           Opacity="0.8"
                           Name="WorldLastPlayed">
                    LastPlayed Time
                </TextBlock>
            </onePointControls:SettingCard>
            <StackPanel Name="ControlPanel">
                <onePointControls:SettingCard Name="EditBtn"
                                              IsClickable="True"
                                              Glyph="&#xE713;"
                                              Header="存档编辑"
                                              Click="EditBtn_OnClick">
                </onePointControls:SettingCard>
                <onePointControls:SettingCard Header="打开存档目录"
                                              IsClickable="True"
                                              Glyph="&#xE8B7;"
                                              Name="OpenFolderBtn"
                                              Click="OpenFolderBtn_OnClick">
                </onePointControls:SettingCard>
                <onePointControls:SettingCard Header="导出存档"
                                              IsClickable="True"
                                              Glyph="&#xE74E;"
                                              Name="SaveBtn"
                                              Click="SaveBtn_OnClick">
                </onePointControls:SettingCard>
                <onePointControls:SettingCard Header="删除存档"
                                              IsClickable="True"
                                              Glyph="&#xE74D;"
                                              Name="DeleteBtn"
                                              Click="DeleteBtn_OnClick">
                </onePointControls:SettingCard>
            </StackPanel>
        </StackPanel>
    </onePointControls:SettingExpander>
</UserControl>