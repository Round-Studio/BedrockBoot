<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.InstanceSubPage.DrawContent.InstanceMods">
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto">
            <items:BorderCard Grid.Column="0"
                              Margin="20,8,12,10">
                <Grid ColumnDefinitions="*">
                    <DockPanel HorizontalAlignment="Stretch"
                               LastChildFill="True">
                        <onePointControls:FontIcon Glyph="&#xE71E;"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   Margin="5,5,12,5"></onePointControls:FontIcon>
                        <TextBox Name="SearchBox"
                                 HorizontalAlignment="Stretch"
                                 DockPanel.Dock="Right"></TextBox>
                    </DockPanel>
                </Grid>
            </items:BorderCard>
            <items:BorderCard Grid.Column="1"
                              Margin="0,8,20,10">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Button Classes="NoBorder"
                                Width="32"
                                Height="32">
                            <onePointControls:FontIcon Glyph="&#xE8B7;"
                                                       VerticalAlignment="Center"></onePointControls:FontIcon>
                        </Button>
                        
                        <Button Classes="NoBorder"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <onePointControls:FontIcon Glyph="&#xE710;"
                                                           VerticalAlignment="Center"
                                                           Margin="0,1,8,0"></onePointControls:FontIcon>
                                <TextBlock>导入模组</TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </items:BorderCard>
        </Grid>
        
        <ScrollViewer Grid.Row="1">
            <WrapPanel Margin="15,0,15,15"
                       HorizontalAlignment="Stretch"
                       Name="SavesBox">
            </WrapPanel>
        </ScrollViewer>
        
        <notice:InfoCard Grid.Row="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Name="NullBox"
                         IsVisible="False"
                         BigTitle="空空如也"
                         Message="输入的关键词无效 或 这个实例没有模组"/>
    </Grid>
</UserControl>
