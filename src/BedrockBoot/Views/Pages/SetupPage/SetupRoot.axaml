<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:navigation="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation;assembly=OnePointUI.Avalonia"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.SetupPage.SetupRoot">
    <Grid RowDefinitions="Auto,*,Auto"
          Background="{DynamicResource BackgroundBrush}">
        <items:BorderCard Grid.Row="0"
                Height="48"
                Margin="10"
                CornerRadius="8"
                HorizontalAlignment="Center"
                Padding="12,0">
            <Grid>
                <TabControl HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Name="TopProgressBar"
                            Margin="0,2,0,0">
                </TabControl>
                
                <Border Background="#010000FE"
                        Opacity="0.000001"></Border>
            </Grid>
        </items:BorderCard>
        
        <navigation:NavigationFrame Grid.Row="1"
                                    Name="SetupFrame"/>
        
        <Grid Row="2">
            <Grid HorizontalAlignment="Left"
                  VerticalAlignment="Stretch"
                  Margin="15">
                <StackPanel Orientation="Horizontal">
                    <Image Source="avares://BedrockBoot/Assets/Icon/BedrockBoot.Icon.256x.png"
                           Width="42"
                           Height="42"
                           Margin="5"></Image>
                    
                    <StackPanel>
                        <TextBlock Margin="5"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Text="BedrockBoot v2"></TextBlock>
                        <TextBlock Margin="5,0,0,0"
                                   FontSize="11"
                                   Text="新一代 Minecraft 基岩版启动器"></TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>
            
            <DockPanel Margin="15"
                       HorizontalAlignment="Right"
                       LastChildFill="False">
                <Button Padding="28,12"
                        IsEnabled="False"
                        Name="ButtonLast"
                        Click="ButtonLast_OnClick"
                        Margin="5"
                        Classes="NoBorder">
                    <StackPanel Orientation="Horizontal">
                        <onePointControls:FontIcon Glyph="&#xE72B;"
                                                   Margin="0,1,0,0"
                                                   VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Text="上一步"></TextBlock>
                    </StackPanel>
                </Button>
                
                <Button Padding="28,12"
                        IsEnabled="False"
                        Name="ButtonNext"
                        Click="ButtonNext_OnClick"
                        Margin="5"
                        Classes="NoBorder">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Text="下一步"></TextBlock>
                        <onePointControls:FontIcon Glyph="&#xE72A;"
                                                   Margin="0,1,0,0"
                                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
