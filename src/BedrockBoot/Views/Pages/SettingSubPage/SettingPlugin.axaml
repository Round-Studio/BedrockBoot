<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.SettingSubPage.SettingPlugin">
    <ScrollViewer>
        <StackPanel Margin="15"
                    Spacing="8">
            <TextBlock Margin="5, 0"
                       FontWeight="Bold"
                       FontSize="14"
                       Text="{DynamicResource Shared.Group.BasicSettings}" />

            <onePointControls:SettingCard Margin="5, 0"
                                          Header="{DynamicResource Settings.Plugin.Manager.Title}"
                                          Description="{DynamicResource Settings.Plugin.Manager.Desc}"
                                          Name="PluginManager"
                                          Click="PluginManager_OnClick"
                                          IsClickable="True"
                                          Glyph="&#xECAA;" />

            <StackPanel Name="PluginSetting"
                        Margin="5, 0"
                        Spacing="8">
                <TextBlock FontWeight="Bold"
                           FontSize="14"
                           Text="{DynamicResource Settings.Plugin.Settings.Title}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>