<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             xmlns:navigation="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation;assembly=OnePointUI.Avalonia"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.MainPage">
    <Grid RowDefinitions="Auto,*">
        <onePointControls:LineTextBlock Grid.Row="0"
                   Margin="20,15,0,0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   FontSize="28"
                   FontWeight="Heavy"
                   Text="你好，欢迎回来"></onePointControls:LineTextBlock>
        
        <items:BorderCard Grid.Row="0"
                          Margin="20,20,20,5"
                          MaxHeight="48"
                          HorizontalAlignment="Right">
            <TabControl Margin="0,2,0,0"
                        SelectionChanged="SelTag_OnSelectionChanged"
                        Name="SelTag">
                <TabItem Header="主页"
                         Tag="Home"></TabItem>
                <TabItem Header="实例"
                         Tag="Manager"></TabItem>
                <TabItem Header="下载"
                         Tag="Download"></TabItem>
                <TabItem Header="设置"
                         Tag="Setting"></TabItem>
            </TabControl>
        </items:BorderCard>
        
        <navigation:NavigationFrame Grid.Row="1"
                                    Name="MainFrame"/>
    </Grid>
</UserControl>
