<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
             xmlns:navigation="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.DownloadPage.SearchSubPage.SearchDetailed">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0"
                    Spacing="10"
                    Margin="20,5,20,0"
                    Orientation="Horizontal">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <onePointControls:FontIcon Glyph="&#xE97C;"
                                           VerticalAlignment="Center"
                                           FontSize="15" />

                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Download.Search.Label.ResourceType}" />
            </StackPanel>

            <ComboBox Width="120"
                      HorizontalAlignment="Stretch"
                      SelectedIndex="0"
                      SelectionChanged="ResourceTypeBox_OnSelectionChanged"
                      Name="ResourceTypeBox">
                <ComboBoxItem Content="Minecraft" />
                <ComboBoxItem Content="{DynamicResource Download.Tab.Assets}" />
                <ComboBoxItem Content="插件" />
            </ComboBox>

            <StackPanel Orientation="Horizontal"
                        Name="MinecraftTypePanel"
                        Spacing="10">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <onePointControls:FontIcon Glyph="&#xE71C;"
                                               VerticalAlignment="Center"
                                               FontSize="15" />

                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource Download.Search.Label.PublishType}" />
                </StackPanel>

                <ComboBox Width="120"
                          HorizontalAlignment="Stretch"
                          SelectedIndex="1"
                          SelectionChanged="GameType_OnSelectionChanged"
                          Name="GameType">
                    <ComboBoxItem Content="{DynamicResource Download.Game.Type.Preview}" />
                    <ComboBoxItem Content="{DynamicResource Download.Game.Type.Release}" />
                    <ComboBoxItem Content="{DynamicResource Download.Game.Type.Beta}" />
                </ComboBox>
				<onePointControls:FontIcon Glyph="&#xE9CE;"
															   VerticalAlignment="Center"
															   FontSize="15" />
				<HyperlinkButton HorizontalAlignment="Right"
                                 Content="找不到想要的版本？"
								 Click="HelpBtn_OnClick">
				</HyperlinkButton>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Name="CurseForgeResTypePanel"
                        Spacing="10"
                        IsVisible="False">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <onePointControls:FontIcon Glyph="&#xF0E2;"
                                               VerticalAlignment="Center"
                                               FontSize="15" />

                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource Download.Search.Label.Category}" />
                </StackPanel>

                <ComboBox Width="120"
                          Name="CurseForgeResTypeBox"
                          SelectedIndex="0"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="CurseForgeResTypeBox_OnSelectionChanged">
                    <ComboBoxItem Content="所有资源" />
                    <ComboBoxItem Content="附加包" />
                    <ComboBoxItem Content="地图" />
                    <ComboBoxItem Content="材质包" />
                    <ComboBoxItem Content="脚本包" />
                    <ComboBoxItem Content="皮肤包" />
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <navigation:LotsPageFrame Grid.Row="1"
                                  Name="ResultPage" />

        <notice:LoadCard Grid.Row="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Name="LoadingRing"
                         BigTitle="{DynamicResource Shared.Status.Searching}"
                         Message="{DynamicResource Shared.Status.Wait}" />

        <notice:InfoCard Grid.Row="1"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Glyph="&#xE822;"
                         BigTitle="{DynamicResource Download.Search.Status.NoResult.Title}"
                         Message="{DynamicResource Download.Search.Status.NoResult.Message}"
                         Name="NoneBox" />
    </Grid>
</UserControl>