<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="300"
             x:Class="BedrockBoot.Views.DialogContent.Export.DialogExportWorldPackContent">
    <ScrollViewer>
        <StackPanel Spacing="8">
            <TextBlock HorizontalAlignment="Left"
                       Text="{DynamicResource Dialog.ExportWorld.Type}" />
            <ComboBox Name="ExportType"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="ExportType_OnSelectionChanged"
                      SelectedIndex="0">
                <ComboBoxItem Content="{DynamicResource Dialog.ExportWorld.Type.World}"></ComboBoxItem>
                <ComboBoxItem Content="{DynamicResource Dialog.ExportWorld.Type.Template}"></ComboBoxItem>
            </ComboBox>

            <StackPanel Name="TemplateItems"
                        Spacing="8"
                        IsVisible="False">
                <TextBlock HorizontalAlignment="Left"
                           Text="{DynamicResource Dialog.ExportWorld.Template.Name}" />
                <TextBox Name="NameInputBox" />
                
                <TextBlock HorizontalAlignment="Left"
                           Text="{DynamicResource Dialog.ExportWorld.Template.Description}" />
                <TextBox Name="DescriptionInputBox" />
                
                <TextBlock HorizontalAlignment="Left"
                           Text="{DynamicResource Dialog.ExportWorld.Template.Version}" />
                <TextBox Name="VersionInputBox" />
                
                <CheckBox Content="{DynamicResource Dialog.ExportWorld.Template.UseWorldSettings}"
                          IsChecked="True"
                          Name="LockTemplateOptions"
                          Margin="0"></CheckBox>
                <CheckBox Content="{DynamicResource Dialog.ExportWorld.Template.AllowRandomSeed}"
                          Name="AllowRandomSeed"
                          Margin="0"></CheckBox>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
