<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d"
             x:Class="BedrockBoot.Views.DialogContent.Loader.PreLoad.NET.DialogPreviewFunctionContent">
    <Grid Width="420"
          MinHeight="320">
        <StackPanel Name="FunctionStackPanel"
                    Spacing="8"
                    Background="#01000000">
                
        </StackPanel>
        
        <notice:InfoCard Name="InfoCard"
                         BigTitle="无法加载配置项"
                         Message="也许是还未启动过游戏？&#10;请尝试启动一次游戏后再进行配置&#10;如依旧无效，请前往启动器更新配置页面&#10;以更新游戏运行组件"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
    </Grid>
</UserControl>
