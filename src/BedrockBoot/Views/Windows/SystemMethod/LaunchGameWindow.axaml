<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="120"
        CanMaximize="False" 
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        x:Class="BedrockBoot.Views.Windows.SystemMethod.LaunchGameWindow"
        Title="{DynamicResource LaunchWindow.Title}">
    <Grid>
        <StackPanel Spacing="8"
                    Width="300"
                    Margin="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
            <TextBlock Name="GameNameBox" 
                       FontSize="16" 
                       Text="{DynamicResource LaunchWindow.Status.Launching}"/>
            <ProgressBar Name="LaunchProgressBar" 
                         IsIndeterminate="True"/>
            <TextBlock Name="ProgressBox" 
                       Text="{DynamicResource LaunchWindow.Status.Preparing}"/>
            

            <StackPanel Name="UwpChoicePanel"
                        IsVisible="False"
                        Spacing="8">
                <TextBlock Name="UwpDepsText"
                           TextWrapping="Wrap"/>
                <Button Name="UwpFixBtn"
                        Content="{DynamicResource LaunchWindow.Status.UWP.Fix}"
                        Padding="8"
                        Classes="Accent"
                        Click="OnUwpFixClick"/>
                <Button Name="UwpLaunchAnywayBtn"
                        Content="{DynamicResource LaunchWindow.Status.UWP.LaunchAnyway}"
                        Padding="8"
                        Click="OnUwpLaunchAnywayClick"/>
                <Button Name="UwpCancelBtn"
                        Content="{DynamicResource LaunchWindow.Status.UWP.Cancel}"
                        Padding="8"
                        Classes="NoBorder"
                        Background="{DynamicResource SystemFillColorCriticalBrush}"
                        Click="OnUwpCancelClick"/>
            </StackPanel>

            <ContentControl Name="UwpFixHost" IsVisible="False"/>

            <Button Name="KillButton"
                    Content="{DynamicResource LaunchWindow.Action.EndProcess}"
                    Padding="8"
                    Background="{DynamicResource SystemFillColorCriticalBrush}"
                    Classes="NoBorder"
                    IsEnabled="False"
                    Click="OnKillButtonClick"/>
        </StackPanel>
    </Grid>
</Window>