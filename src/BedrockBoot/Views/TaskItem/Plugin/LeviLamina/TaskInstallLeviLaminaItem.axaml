<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400"
             x:Class="BedrockBoot.Views.TaskItem.Plugin.LeviLamina.TaskInstallLeviLaminaItem">
    <items:BorderCard>
        <Grid ColumnDefinitions="Auto,*">
            <onePointControls:ProgressRing Grid.Column="0"
                                           Width="36"
                                           Height="36"
                                           VerticalAlignment="Top"
                                           Margin="4,4,0,0"
                                           Background="Transparent" />

            <StackPanel Grid.Column="1" Margin="15,0,10,0"
                        HorizontalAlignment="Stretch">
                <TextBlock FontSize="16"
                           Name="CardTitle"
                           Text="{DynamicResource Task.LeviLamina.Title}" />

                <StackPanel Margin="0,8,0,0"
                            HorizontalAlignment="Stretch">
                    <ProgressBar IsIndeterminate="True"
                                 HorizontalAlignment="Stretch"
                                 Margin="0,0,0,8"
                                 Name="MainProgressBar" />

                    <DockPanel>
                        <TextBlock Width="120" Text="{DynamicResource Task.LeviLamina.Step.Manifest}" />
                        <ProgressBar HorizontalAlignment="Stretch"
                                     Name="InsDownSourceBar" />
                    </DockPanel>

                    <DockPanel>
                        <TextBlock Width="120" Text="{DynamicResource Task.LeviLamina.Step.Core}" />
                        <ProgressBar HorizontalAlignment="Stretch"
                                     Name="InsLLMBar" />
                    </DockPanel>

                    <DockPanel>
                        <TextBlock Width="120" Text="{DynamicResource Task.LeviLamina.Step.Logger}" />
                        <ProgressBar HorizontalAlignment="Stretch"
                                     Name="InsLogBar" />
                    </DockPanel>

                    <DockPanel>
                        <TextBlock Width="120" Text="{DynamicResource Task.LeviLamina.Step.Loader}" />
                        <ProgressBar HorizontalAlignment="Stretch"
                                     Name="InsPreLoaderBar" />
                    </DockPanel>

                    <DockPanel>
                        <TextBlock Width="120" Text="{DynamicResource Task.LeviLamina.Step.Runtime}" />
                        <ProgressBar HorizontalAlignment="Stretch"
                                     Name="InsRuntimeBar" />
                    </DockPanel>

                    <Grid ColumnDefinitions="*,*">
                        <TextBlock Grid.Column="0"
                                   Foreground="Gray"
                                   FontSize="9"
                                   Margin="0,2,0,0"
                                   Name="MainText" />

                        <TextBlock Grid.Column="1"
                                   Foreground="Gray"
                                   FontSize="9"
                                   Margin="0,2,0,0"
                                   Name="MainSpeedText">
                            0 B/s
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>
    </items:BorderCard>
</UserControl>