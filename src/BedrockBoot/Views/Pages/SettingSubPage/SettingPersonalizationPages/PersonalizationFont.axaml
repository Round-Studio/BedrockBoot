<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.SettingSubPage.SettingPersonalizationPages.PersonalizationFont">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8" Margin="20,20,20,0">
            <TextBlock FontWeight="Bold" FontSize="14" Text="{DynamicResource Settings.Personalization.Font.Group.Font}" />

            <onePointControls:SettingCard Header="{DynamicResource Settings.Personalization.Font.Main.Title}" Description="{DynamicResource Settings.Personalization.Font.Main.Desc}" Glyph="&#xE8D2;">
                <ComboBox Width="300" Name="MainFontComboBox" SelectionChanged="MainFontComboBox_SelectionChanged"></ComboBox>
            </onePointControls:SettingCard>

            <onePointControls:SettingCard Header="{DynamicResource Settings.Personalization.Font.Fallback.Title}" Description="{DynamicResource Settings.Personalization.Font.Fallback.Desc}" Glyph="&#xE8D2;">
                <ComboBox Width="300" Name="FallbackFontComboBox" SelectionChanged="FallbackFontComboBox_SelectionChanged"></ComboBox>
            </onePointControls:SettingCard>

            <TextBlock FontWeight="Bold" FontSize="14" Text="{DynamicResource Settings.Personalization.Font.Group.Preview}" />

            <DockPanel HorizontalSpacing="8">
                <TextBlock Text="{DynamicResource Settings.Personalization.Font.Preview.Size}" VerticalAlignment="Center"></TextBlock>
                <Slider Classes="Number" Minimum="8" Maximum="72" Name="FontSizeSlider" Value="72" ValueChanged="FontSizeSlider_ValueChanged"
                        Margin="0"></Slider>
            </DockPanel>

            <DockPanel HorizontalSpacing="8">
                <TextBlock Text="{DynamicResource Settings.Personalization.Font.Preview.Text}" VerticalAlignment="Center"></TextBlock>
                <TextBox Name="PreviewTextInput" Watermark="{DynamicResource Settings.Personalization.Font.Preview.Watermark}" TextChanged="PreviewTextInput_TextChanged"></TextBox>
            </DockPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,0" Spacing="8" Name="PreviewPanel">
                <TextBlock Name="PreviewRegular"/>
                <TextBlock Name="PreviewItalic" FontStyle="Italic"/>
                <TextBlock Name="PreviewBold" FontWeight="Bold"/>
                <TextBlock Name="PreviewBoldItalic" FontStyle="Italic" FontWeight="Bold"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>