<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800"
             x:Class="BedrockBoot.Views.Control.Items.CurseForgeModItem">
    <onePointControls:SettingCard IsClickable="True"
                                  Name="Card"
                                  Click="Card_OnClick"
                                  Margin="5,0,5,10"
                                  Glyph="&#xE91B;"
                                  Description="{DynamicResource Download.CurseForge.Label.PackInfo}">
        <onePointControls:SettingCard.Header>
            <StackPanel Orientation="Horizontal"
                        Name="HeaderBox"
                        Spacing="8">
                <TextBlock Name="PackName"
                           Text="PackName" />
            </StackPanel>
        </onePointControls:SettingCard.Header>
    </onePointControls:SettingCard>
</UserControl>