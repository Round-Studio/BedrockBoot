    <x:String x:Key="About.Page.Credits.Desc">Thanks to the following services and projects for supporting BedrockBoot</x:String>
    <x:String x:Key="About.Page.Inspiration.Desc">BedrockBoot was partially inspired by the following projects</x:String>
    <x:String x:Key="About.Page.LayoutCredit.Desc">Some page layouts in BedrockBoot reference PCL CE</x:String>
    <x:String x:Key="About.Page.BakaXL.Desc">Some BedrockBoot features are referenced from BakaXL</x:String>
    <x:String x:Key="About.Page.BMCBL.Desc">Some BedrockBoot features are referenced from BMCBL</x:String>
    <x:String x:Key="About.Page.Developers.Desc">BedrockBoot developers and technical support</x:String>
    <x:String x:Key="About.Page.CoreDev">BedrockBoot Core Development</x:String>
    <x:String x:Key="About.Page.UIDev">UI Design and Interaction</x:String>
    <x:String x:Key="About.Page.ProtocolDev">Protocol planning and technical support</x:String>
    <x:String x:Key="About.Page.NetworkDev">Network infrastructure support, technical support for PaperConnect v2</x:String>
    <x:String x:Key="About.Page.AllContributors">And all BedrockBoot contributors</x:String>
    <x:String x:Key="About.Page.AllContributors.Desc">Thanks to all developers who have contributed code, documentation, design, and testing to BedrockBoot</x:String>
    <x:String x:Key="About.Page.Links">Related Links</x:String>
    <x:String x:Key="About.Page.Links.Desc">Project, organization, and issue report links</x:String>
